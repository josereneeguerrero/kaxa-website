---
import { translations } from '../i18n/translations';
import { PLAY_STORE_URL } from '../i18n/constants';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section class="bg-ink py-16 text-center text-white">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <h2 class="text-3xl font-extrabold">{t.cta.title}</h2>
    <p class="mt-3 text-white/70">{t.cta.subtitle}</p>
    {'ctaWaitlist' in t.cta && t.cta.ctaWaitlist ? (
      <form id="cta-waitlist-form" class="mx-auto mt-8 flex max-w-md gap-2">
        <input
          type="email"
          name="email"
          required
          placeholder="tucorreo@ejemplo.com"
          class="flex-1 rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm text-white placeholder-white/40 shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        />
        <button
          type="submit"
          class="whitespace-nowrap rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-primary/90 active:scale-95"
        >
          {t.cta.button}
        </button>
      </form>
      <p id="cta-waitlist-success" class="mt-4 hidden text-sm font-medium text-primary">
        🎉 ¡Listo! Te avisaremos antes que nadie.
      </p>
    ) : (
      <a href={PLAY_STORE_URL} class="mt-8 inline-block transition hover:opacity-90">
        <img
          src={`/badges/google-play-badge-${lang}.png`}
          alt={t.cta.button}
          class="h-14 w-auto"
          width="194"
          height="75"
        />
      </a>
    )}
  </div>
</section>

<script>
  const form = document.getElementById('cta-waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('cta-waitlist-success');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email') as string;
      const btn = form.querySelector('button')!;
      btn.textContent = '...';
      btn.disabled = true;
      try {
        await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch {
        btn.textContent = 'Reintentar';
        btn.disabled = false;
      }
    });
  }
</script>
