---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.reneeguerrero.kaxa';
---
<section class="bg-ink py-16 text-center text-white">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <h2 class="text-3xl font-extrabold">{t.cta.title}</h2>
    <p class="mt-3 text-white/70">{t.cta.subtitle}</p>
    <div class="mt-8 flex justify-center">
      <a href={playStoreUrl} target="_blank" rel="noopener" class="inline-block transition hover:opacity-90 active:scale-95">
        <img
          src={lang === 'es' ? '/badges/google-play-badge-es.png' : '/badges/google-play-badge-en.png'}
          alt={lang === 'es' ? 'Disponible en Google Play' : 'Get it on Google Play'}
          class="h-14"
        />
      </a>
    </div>
  </div>
</section>
