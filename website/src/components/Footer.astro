---
import { translations } from '../i18n/translations';
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { PLAY_STORE_URL } from '../i18n/constants';

interface Props {
  lang: Lang;
  currentRoute: RouteKey;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<footer class="border-t border-surface-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <img src="/images/kaxa_wordmark_green.png" alt="Kaxa" class="h-7 w-auto" />
        <p class="mt-3 text-sm text-muted">{t.footer.tagline}</p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.legalTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={routes.privacy[lang]} class="hover:text-primary">{t.footer.privacy}</a></li>
          <li><a href={routes.terms[lang]} class="hover:text-primary">{t.footer.terms}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.supportTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={routes.support[lang]} class="hover:text-primary">{t.footer.supportLink}</a></li>
          <li><a href={`mailto:${t.footer.contactEmail}`} class="hover:text-primary">{t.footer.contactEmail}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.downloadTitle}</h3>
        <a
          href={PLAY_STORE_URL}
          class="mt-3 inline-block rounded-btn bg-ink px-4 py-2 text-sm font-bold text-white hover:bg-primary"
        >
          Google Play
        </a>
      </div>
    </div>
    <p class="mt-10 text-xs text-muted">{t.footer.copyright}</p>
  </div>
</footer>
