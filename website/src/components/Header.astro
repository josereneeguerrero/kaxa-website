---
import { translations } from '../i18n/translations';
import { routes, otherLang, type Lang, type RouteKey } from '../i18n/routes';
import { PLAY_STORE_URL } from '../i18n/constants';


interface Props {
  lang: Lang;
  currentRoute: RouteKey;
}

const { lang, currentRoute } = Astro.props;
const t = translations[lang];
const home = routes.home[lang];
const switchHref = routes[currentRoute][otherLang(lang)];
---
<header class="sticky top-0 z-50 border-b border-surface-border bg-white/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href={home} class="flex items-center gap-2">
      <img src="/apple-touch-icon.png" alt="" class="h-8 w-8 rounded-xl" aria-hidden="true" />
      <img src="/images/kaxa_wordmark_green.png" alt="Kaxa" class="h-5 w-auto" />
    </a>
    <nav class="hidden items-center gap-8 text-sm font-semibold text-ink md:flex">
      <a href={`${home}#como-funciona`} class="hover:text-primary">{t.nav.howItWorks}</a>
      <a href={`${home}#funciones`} class="hover:text-primary">{t.nav.features}</a>
      <a href={`${home}#precios`} class="hover:text-primary">{t.nav.pricing}</a>
      <a href={routes.support[lang]} class="hover:text-primary">{t.nav.support}</a>
    </nav>
    <div class="flex items-center gap-3">
      <a
        href={switchHref}
        class="text-sm font-bold text-muted hover:text-primary"
        aria-label="Switch language"
      >
        {lang === 'es' ? 'EN' : 'ES'}
      </a>
      <a
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener"
        class="hidden rounded-btn bg-primary px-4 py-2 text-sm font-bold text-white shadow-card hover:bg-primary-dark sm:inline-block"
      >
        {t.nav.download}
      </a>
      <button
        id="menu-toggle"
        class="flex items-center justify-center md:hidden"
        aria-label="Menu"
      >
        <svg class="h-6 w-6 text-ink" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
  <nav
    id="mobile-menu"
    class="hidden border-t border-surface-border bg-white px-4 py-4 md:hidden"
  >
    <div class="flex flex-col gap-4 text-sm font-semibold text-ink">
      <a href={`${home}#como-funciona`} class="hover:text-primary">{t.nav.howItWorks}</a>
      <a href={`${home}#funciones`} class="hover:text-primary">{t.nav.features}</a>
      <a href={`${home}#precios`} class="hover:text-primary">{t.nav.pricing}</a>
      <a href={routes.support[lang]} class="hover:text-primary">{t.nav.support}</a>
      <a
        href={PLAY_STORE_URL}
        target="_blank"
        rel="noopener"
        class="rounded-btn bg-primary px-4 py-2 text-center text-sm font-bold text-white shadow-card hover:bg-primary-dark"
      >
        {t.nav.download}
      </a>
    </div>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => menu.classList.add('hidden'));
    });
  }
</script>
