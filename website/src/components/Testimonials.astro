---
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const es = lang === 'es';

const heading    = es ? 'Lo que dicen los testers' : 'What our testers say';
const subheading = es
  ? 'Feedback real de las 12 personas que probaron Kaxa antes del lanzamiento.'
  : 'Real feedback from the 12 people who tested Kaxa before launch.';
const ratingLabel = es ? 'Promedio · 12 testers' : 'Average · 12 testers';

const reviews = es ? [
  {
    name: 'Karla M.',
    stars: 5,
    title: 'Por fin una que duré usando',
    text: 'Probé como 4 apps de finanzas y siempre las dejaba a la semana. Con Kaxa llevé dos meses seguidos sin fallar. El truco es que registro con voz y se acaba el drama del formulario.',
  },
  {
    name: 'Sofía B.',
    stars: 5,
    title: 'La primera que no prometió demasiado',
    text: 'Era escéptica. Todas prometen lo mismo. Kaxa fue la primera que simplemente funcionó sin pedirme que confiara en ella.',
  },
  {
    name: 'Ana L.',
    stars: 5,
    title: 'El OCR me voló la cabeza',
    text: 'Tomé foto al ticket del súper y puso el total sola. Sin internet. Eso no lo he visto en ninguna otra app gratuita.',
  },
  {
    name: 'Diego F.',
    stars: 5,
    title: 'Los bolsillos me cambiaron la mentalidad',
    text: 'Antes veía el saldo total y creía que tenía plata. Ahora sé exactamente cuánto es de la renta y cuánto puedo gastar. Esa diferencia vale todo.',
  },
  {
    name: 'Luis E.',
    stars: 5,
    title: 'Se acabaron las discusiones por dinero',
    text: 'Mi pareja y yo llevamos la plata juntos. Antes era tensión cada mes. Ahora los dos vemos los mismos bolsillos y cada quien sabe cuánto puede gastar.',
  },
  {
    name: 'Rodrigo C.',
    stars: 5,
    title: 'La alerta del 80% me salvó el mes',
    text: 'Me avisa cuando voy al 80% del presupuesto. Eso es lo que necesitaba: saber antes de pasarme, no enterarme después de que ya no hay nada que hacer.',
  },
  {
    name: 'Daniela M.',
    stars: 4,
    title: 'Me mostró dónde realmente gasto',
    text: 'Soy estudiante. El presupuesto por categoría me mostró que el problema era el café y las salidas, no el arriendo. Eso no lo hubiera visto en un Excel.',
  },
  {
    name: 'María J.',
    stars: 5,
    title: '5 minutos y ya estás adentro',
    text: 'Sin cuenta, sin conectar el banco, sin permisos raros. Abrí, registré mi primer gasto en voz y listo.',
  },
  {
    name: 'Pablo S.',
    stars: 4,
    title: 'Hasta las deudas personales maneja',
    text: 'Tenía una deuda con un amigo anotada en papel desde hace meses. La metí a Kaxa con fecha y cuota. Ya no se me olvida y ya no es incómodo.',
  },
  {
    name: 'Javier A.',
    stars: 5,
    title: 'Perfecta para ingresos variables',
    text: 'Trabajo independiente y mis ingresos no son fijos. La meta de ahorro me dice cuánto necesito juntar antes de poder relajarme con los gastos del mes. No hay otra app que lo haga así de simple.',
  },
  {
    name: 'Valeria R.',
    stars: 5,
    title: 'Perfecta para el efectivo del negocio',
    text: 'La uso para el efectivo del negocio de mi mamá. Sin membresía. Sin internet.',
  },
  {
    name: 'Carlos T.',
    stars: 5,
    title: 'Sin cuenta, sin trámite',
    text: 'Que no me pidiera correo ni contraseña fue lo que me convenció. Instalé, abrí y ya estaba funcionando. Sin esperar confirmación ni nada.',
  },
] : [
  {
    name: 'Karen M.',
    stars: 5,
    title: 'Finally one I actually kept using',
    text: "I tried 4 finance apps and always dropped them within a week. With Kaxa I've gone two months straight. The trick is voice logging — no form drama.",
  },
  {
    name: 'Sofia B.',
    stars: 5,
    title: "First one that didn't overpromise",
    text: "I was skeptical. Every finance app promises the same thing. Kaxa was the first one that just worked — no asking me to trust it first.",
  },
  {
    name: 'Ana L.',
    stars: 5,
    title: 'The receipt OCR blew my mind',
    text: "I took a photo of the grocery receipt and it filled in the total by itself. Offline. I've never seen that in a free app.",
  },
  {
    name: 'Diego F.',
    stars: 5,
    title: 'Pockets changed how I think about money',
    text: 'I used to see my total balance and think I had money. Now I know exactly how much is for rent and how much I can actually spend.',
  },
  {
    name: 'Luis E.',
    stars: 5,
    title: 'No more money arguments',
    text: "My partner and I share finances. Every month used to bring tension. Now we both see the same pockets and know how much each of us can spend. No more conflict.",
  },
  {
    name: 'Rodrigo C.',
    stars: 5,
    title: 'The 80% alert saved my month',
    text: "It warns me when I hit 80% of my budget. That's what I needed — knowing before I overspend, not after there's nothing left to do.",
  },
  {
    name: 'Daniela M.',
    stars: 4,
    title: 'Showed me where I actually spend',
    text: "I'm a student. The category budget showed me it was coffee and going out — not rent — that was draining me. I never would have seen that in a spreadsheet.",
  },
  {
    name: 'María J.',
    stars: 5,
    title: "5 minutes and you're in",
    text: 'No account, no bank connection, no weird permissions. I opened it, logged my first expense by voice, done.',
  },
  {
    name: 'Pablo S.',
    stars: 4,
    title: 'Even tracks personal debts',
    text: 'I had a debt to a friend written on paper for months. I added it to Kaxa with a date and installment. No more forgetting, no more awkwardness.',
  },
  {
    name: 'Javier A.',
    stars: 5,
    title: 'Built for variable income',
    text: "I'm freelance — income isn't fixed. The savings goal tells me how much I need to save before I can relax on spending that month. No other app does that this simply.",
  },
  {
    name: 'Valeria R.',
    stars: 5,
    title: 'Perfect for the family business',
    text: "I use it to track my mom's business cash. No subscription. Works offline.",
  },
  {
    name: 'Carlos T.',
    stars: 5,
    title: 'No account, no hassle',
    text: 'Not asking for an email or password was what sold me. Installed, opened, and it was already working. No confirmation email, nothing.',
  },
];
---

<section class="tm-section">

  <!-- Header -->
  <div class="tm-header">
    <span class="reveal tm-eyebrow">{es ? 'Reseñas' : 'Reviews'}</span>
    <h2 class="reveal tm-title" style="transition-delay:60ms">{heading}</h2>
    <p class="reveal tm-subtitle" style="transition-delay:120ms">{subheading}</p>

    <!-- Rating badge -->
    <div class="reveal tm-rating" style="transition-delay:180ms">
      <span class="tm-score">4.8</span>
      <div class="tm-rating-right">
        <span class="tm-stars" aria-hidden="true">★★★★★</span>
        <span class="tm-rating-label">{ratingLabel}</span>
      </div>
    </div>
  </div>

  <!-- Masonry grid with fade + expand -->
  <div class="tm-wrap" id="tm-wrap">
    <div class="tm-grid">
      {reviews.map((r, i) => (
        <div class="reveal tm-card" style={`transition-delay:${i * 35}ms`}>
          <div class="tm-card-stars" aria-hidden="true">
            {'★'.repeat(r.stars)}{'☆'.repeat(5 - r.stars)}
          </div>
          <p class="tm-card-title">{r.title}</p>
          <p class="tm-card-text">{r.text}</p>
          <p class="tm-card-name">{r.name}</p>
        </div>
      ))}
    </div>
    <div class="tm-fade" id="tm-fade"></div>
  </div>

  <!-- Show more button -->
  <div class="tm-more-wrap">
    <button class="tm-more-btn" id="tm-btn" type="button">
      {es ? 'Ver más reseñas' : 'Show more reviews'}
      <svg id="tm-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
  </div>

</section>

<script>
  const wrap    = document.getElementById('tm-wrap');
  const fade    = document.getElementById('tm-fade');
  const btn     = document.getElementById('tm-btn');
  const chevron = document.getElementById('tm-chevron');

  if (wrap && fade && btn && chevron) {
    btn.addEventListener('click', () => {
      const expanded = wrap.classList.toggle('tm-wrap--open');
      fade.style.opacity = expanded ? '0' : '1';
      chevron.style.transform = expanded ? 'rotate(180deg)' : '';
      btn.firstChild!.textContent = expanded
        ? (document.documentElement.lang === 'es' ? ' Ver menos' : ' Show less')
        : (document.documentElement.lang === 'es' ? ' Ver más reseñas' : ' Show more reviews');
    });
  }
</script>

<style>
  .tm-section {
    background: #fff;
    padding: 80px 0 96px;
  }

  .tm-header {
    max-width: 640px;
    margin: 0 auto 52px;
    padding: 0 24px;
    text-align: center;
  }

  .tm-eyebrow {
    display: inline-block;
    margin-bottom: 14px;
    padding: 6px 16px;
    border-radius: 9999px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
    background: rgba(11,28,48,.06);
    color: var(--color-ink, #0B1C30);
  }

  .tm-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-ink, #0B1C30);
    margin: 0 0 12px;
    text-wrap: balance;
    line-height: 1.2;
  }

  .tm-subtitle {
    font-size: 1rem;
    color: var(--color-muted, #6b7280);
    margin: 0 0 28px;
    line-height: 1.6;
  }

  .tm-rating {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    background: #F8F9FF;
    border: 1px solid rgba(0,0,0,.07);
    border-radius: 16px;
    padding: 12px 20px;
  }

  .tm-score {
    font-size: 2.5rem;
    font-weight: 900;
    color: var(--color-ink, #0B1C30);
    line-height: 1;
  }

  .tm-rating-right {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
  }

  .tm-stars {
    font-size: 17px;
    color: #F59E0B;
    letter-spacing: 2px;
  }

  .tm-rating-label {
    font-size: 11px;
    color: var(--color-muted, #6b7280);
    white-space: nowrap;
  }

  /* Wrap with height clip */
  .tm-wrap {
    position: relative;
    max-height: 600px;
    overflow: hidden;
    transition: max-height .6s cubic-bezier(.4,0,.2,1);
  }

  .tm-wrap--open {
    max-height: 3000px;
  }

  /* Gradient fade — starts at top of row 3, covers it fully */
  .tm-fade {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 240px;
    background: linear-gradient(to bottom, transparent, #fff 80%);
    pointer-events: none;
    transition: opacity .25s ease;
  }

  /* Show more button */
  .tm-more-wrap {
    text-align: center;
    margin-top: 20px;
  }

  .tm-more-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 10px 22px;
    border: 1.5px solid rgba(0,0,0,.12);
    border-radius: 9999px;
    background: #fff;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-ink, #0B1C30);
    cursor: pointer;
    transition: border-color .2s, box-shadow .2s;
  }

  .tm-more-btn:hover {
    border-color: rgba(0,0,0,.22);
    box-shadow: 0 2px 8px rgba(0,0,0,.07);
  }

  .tm-more-btn svg {
    width: 14px;
    height: 14px;
    transition: transform .3s ease;
    flex-shrink: 0;
  }

  /* Masonry via CSS columns */
  .tm-grid {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    columns: 3;
    column-gap: 16px;
  }

  .tm-card {
    break-inside: avoid;
    background: #F8F9FF;
    border: 1px solid rgba(0,0,0,.05);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .tm-card-stars {
    font-size: 13px;
    color: #F59E0B;
    letter-spacing: 1px;
  }

  .tm-card-title {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-ink, #0B1C30);
    margin: 0;
    line-height: 1.3;
  }

  .tm-card-text {
    font-size: 13px;
    color: var(--color-muted, #6b7280);
    margin: 0;
    line-height: 1.65;
  }

  .tm-card-name {
    font-size: 11px;
    font-weight: 600;
    color: #b0b7c3;
    margin: 4px 0 0;
    letter-spacing: .02em;
  }

  @media (max-width: 900px) {
    .tm-grid { columns: 2; }
  }

  @media (max-width: 540px) {
    .tm-title { font-size: 1.5rem; }
    .tm-grid { columns: 1; }
  }
</style>
