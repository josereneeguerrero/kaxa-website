---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const eyebrows = lang === 'es'
  ? ['REGISTRO', 'PRESUPUESTOS', 'METAS', 'DEUDAS', 'RESUMEN', 'INTELIGENCIA ARTIFICIAL']
  : ['TRACKING', 'BUDGETS', 'GOALS', 'DEBTS', 'SUMMARY', 'ARTIFICIAL INTELLIGENCE'];

const aiItem = lang === 'es'
  ? {
      title: 'Registra con texto o voz — la IA lo entiende',
      description: 'Escribe "gasté 50 en almuerzo" y Kaxa lo categoriza, le asigna el monto y lo guarda. Sin formularios. Sin menús.',
      screenshot: null,
      bullets: ['Entiende lenguaje natural', 'Categorización automática', 'Rápido como mandar un mensaje'],
    }
  : {
      title: 'Log with text or voice — AI gets it',
      description: 'Type "spent 50 on lunch" and Kaxa categorizes it, assigns the amount, and saves it. No forms. No menus.',
      screenshot: null,
      bullets: ['Understands natural language', 'Auto-categorization', 'As fast as sending a message'],
    };

const allFeatures = [...t.features.items, aiItem];

const micIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>`;
---

<section id="funciones" class="bg-grain overflow-hidden">

  <!-- Header -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-4 text-center">
    <h2 class="reveal text-3xl font-extrabold text-ink sm:text-4xl">{t.features.title}</h2>
    <p class="reveal mx-auto mt-3 max-w-xl text-muted" style="transition-delay:100ms">{t.features.subtitle}</p>
  </div>

  <!-- ── DESKTOP: sticky scroll ── -->
  <div class="hidden lg:block">
    <div class="mx-auto max-w-6xl px-6 pb-24">
      <div class="flex items-start gap-16">

        <!-- Left: stacked feature steps -->
        <div class="w-[50%] features-left">
          {allFeatures.map((f, i) => (
            <div
              class="feature-step min-h-screen flex items-center py-16"
              data-index={String(i)}
            >
              <div class="max-w-sm">
                <p class={`text-xs font-extrabold uppercase tracking-widest mb-3 ${i === 5 ? 'text-emerald-500' : 'text-primary'}`}>
                  {eyebrows[i]}
                </p>
                <h3 class="text-[1.6rem] font-extrabold text-ink leading-snug mb-4" style="text-wrap:balance">
                  {f.title}
                </h3>
                <p class="text-muted leading-relaxed mb-6">{f.description}</p>
                <ul class="space-y-2.5">
                  {f.bullets?.map((b: string) => (
                    <li class="flex items-center gap-2.5 text-sm text-ink/80">
                      <span class={`flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white ${i === 5 ? 'bg-emerald-500' : 'bg-primary'}`}>✓</span>
                      {b}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <!-- Right: sticky phone frame -->
        <div class="w-[50%] sticky top-0 h-screen flex items-center justify-center pointer-events-none">
          <div class="phone-wrap" style="width:272px;height:556px;position:relative;">
            <!-- Bezel -->
            <div style="position:absolute;inset:0;border-radius:44px;background:#111318;box-shadow:0 0 0 1px rgba(255,255,255,0.08),0 40px 100px rgba(0,0,0,0.45),0 8px 24px rgba(0,0,0,0.3);">
              <!-- Dynamic island -->
              <div style="position:absolute;top:14px;left:50%;transform:translateX(-50%);width:88px;height:22px;background:#111318;border-radius:20px;z-index:10;"></div>
              <!-- Screen -->
              <div style="position:absolute;inset:10px;border-radius:36px;overflow:hidden;background:#F4F6FB;">

                <!-- Screenshots -->
                {allFeatures.map((f, i) => (
                  f.screenshot ? (
                    <img
                      src={f.screenshot}
                      alt={f.title}
                      class="phone-screen"
                      data-index={String(i)}
                      style={`position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;transition:opacity 0.45s ease;opacity:${i === 0 ? '1' : '0'};`}
                    />
                  ) : (
                    <div
                      class="phone-screen ai-screen"
                      data-index={String(i)}
                      style={`position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:20px;background:linear-gradient(145deg,#059669,#10B981);transition:opacity 0.45s ease;opacity:0;`}
                    >
                      <div style="position:relative;display:flex;align-items:center;justify-content:center;width:96px;height:96px;">
                        <div class="ai-ring" style="position:absolute;width:96px;height:96px;border-radius:50%;border:2px solid rgba(255,255,255,0.2);"></div>
                        <div class="ai-ring ai-ring-2" style="position:absolute;width:68px;height:68px;border-radius:50%;border:2px solid rgba(255,255,255,0.3);"></div>
                        <div style="width:52px;height:52px;border-radius:50%;background:rgba(255,255,255,0.2);display:flex;align-items:center;justify-content:center;color:white;">
                          <Fragment set:html={micIcon} />
                        </div>
                      </div>
                      <p style="color:rgba(255,255,255,0.85);font-size:13px;font-weight:500;padding:0 24px;text-align:center;line-height:1.5;">
                        {lang === 'es' ? '"gasté 50 en almuerzo"' : '"spent 50 on lunch"'}
                      </p>
                      <div style="display:flex;gap:4px;align-items:center;">
                        {[12, 20, 28, 20, 12].map((h) => (
                          <div class="bar-pulse" style={`width:4px;height:${h}px;background:rgba(255,255,255,0.6);border-radius:2px;`}></div>
                        ))}
                      </div>
                    </div>
                  )
                ))}

                <!-- Screen glare -->
                <div style="position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,0.06) 0%,transparent 60%);pointer-events:none;z-index:20;border-radius:36px;"></div>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── MOBILE: stacked with screenshot above each ── -->
  <div class="lg:hidden mx-auto max-w-sm px-4 pb-16 pt-8 space-y-14">
    {allFeatures.map((f, i) => (
      <div class="reveal" style={`transition-delay:${i * 60}ms`}>
        {f.screenshot ? (
          <div style="border-radius:28px;overflow:hidden;box-shadow:0 16px 48px rgba(0,0,0,0.14);margin-bottom:24px;aspect-ratio:9/16;max-height:360px;">
            <img
              src={f.screenshot}
              alt={f.title}
              style="width:100%;height:100%;object-fit:cover;object-position:top;display:block;"
              loading="lazy"
            />
          </div>
        ) : (
          <div style="border-radius:28px;background:linear-gradient(145deg,#059669,#10B981);height:200px;margin-bottom:24px;display:flex;align-items:center;justify-content:center;color:white;">
            <Fragment set:html={micIcon} />
          </div>
        )}
        <p class={`text-xs font-extrabold uppercase tracking-widest mb-2 ${i === 5 ? 'text-emerald-500' : 'text-primary'}`}>
          {eyebrows[i]}
        </p>
        <h3 class="text-xl font-extrabold text-ink mb-3 leading-snug">{f.title}</h3>
        <p class="text-muted text-sm leading-relaxed mb-4">{f.description}</p>
        <ul class="space-y-2">
          {f.bullets?.map((b: string) => (
            <li class="flex items-center gap-2 text-sm text-ink/70">
              <span class={`flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white ${i === 5 ? 'bg-emerald-500' : 'bg-primary'}`}>✓</span>
              {b}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

</section>

<script>
  const steps = document.querySelectorAll<HTMLElement>('.feature-step');
  const screens = document.querySelectorAll<HTMLElement>('.phone-screen');

  if (steps.length > 0 && screens.length > 0) {
    const setActive = (index: number) => {
      screens.forEach((s, i) => {
        (s as HTMLElement).style.opacity = i === index ? '1' : '0';
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            const idx = Number((entry.target as HTMLElement).dataset.index ?? 0);
            setActive(idx);
          }
        }
      },
      { threshold: 0.4, rootMargin: '-15% 0px -15% 0px' }
    );

    steps.forEach((step) => observer.observe(step));
  }
</script>

<style>
  @keyframes ring-pulse {
    0%, 100% { transform: scale(1); opacity: 0.35; }
    50% { transform: scale(1.12); opacity: 0.08; }
  }
  .ai-ring   { animation: ring-pulse 2.2s ease-in-out infinite; }
  .ai-ring-2 { animation: ring-pulse 2.2s ease-in-out infinite 0.4s; }

  @keyframes bar-wave {
    0%, 100% { transform: scaleY(0.5); opacity: 0.5; }
    50%       { transform: scaleY(1);   opacity: 1;   }
  }
  .bar-pulse { animation: bar-wave 1.1s ease-in-out infinite; transform-origin: center; }
  .bar-pulse:nth-child(1) { animation-delay: 0s; }
  .bar-pulse:nth-child(2) { animation-delay: 0.15s; }
  .bar-pulse:nth-child(3) { animation-delay: 0.3s; }
  .bar-pulse:nth-child(4) { animation-delay: 0.15s; }
  .bar-pulse:nth-child(5) { animation-delay: 0s; }
</style>
