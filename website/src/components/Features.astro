---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = translations[lang];

const labels = lang === 'es'
  ? ['BOLSILLOS', 'VOZ & IA', 'PRESUPUESTOS', 'METAS', 'DEUDAS']
  : ['POCKETS', 'VOICE & AI', 'BUDGETS', 'GOALS', 'DEBTS'];

const features = t.features.items;
---

<section id="funciones" class="bg-grain">

  <!-- Header -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-12 text-center">
    <span class="reveal inline-block mb-4 px-4 py-1.5 rounded-full text-xs font-semibold tracking-wide" style="background:rgba(11,28,48,.06);color:var(--color-ink,#0B1C30);">{t.nav.features}</span>
    <h2 class="reveal text-3xl font-extrabold text-ink sm:text-5xl" style="transition-delay:60ms;text-wrap:balance;">{t.features.title}</h2>
    <p class="reveal mx-auto mt-4 max-w-xl text-muted" style="transition-delay:120ms">{t.features.subtitle}</p>
  </div>

  <!-- Cards -->
  <div class="feat-list">
    {features.map((f, i) => (
      <div class={`reveal feat-card feat-card--${i % 2 === 0 ? 'normal' : 'flip'}`} style={`transition-delay:${i * 60}ms`}>

        <!-- Text -->
        <div class="feat-text">
          <p class="feat-label">{labels[i]}</p>
          <h3 class="feat-title">{f.title}</h3>
          <p class="feat-desc">{f.description}</p>
          <ul class="feat-bullets">
            {f.bullets?.map((b: string) => (
              <li>
                <span class="feat-check">✓</span>
                {b}
              </li>
            ))}
          </ul>
        </div>

        <!-- Visual placeholder -->
        <div class="feat-visual">
          <!-- screenshot aquí -->
        </div>

      </div>
    ))}
  </div>

</section>

<style>
  .feat-list {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .feat-card {
    background: #fff;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 2px 16px rgba(0,0,0,.06), 0 1px 3px rgba(0,0,0,.04);
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 460px;
  }

  .feat-card--flip .feat-text { order: 2; }
  .feat-card--flip .feat-visual { order: 1; }

  .feat-text {
    padding: 56px 52px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .feat-label {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: var(--color-primary, #1DB48B);
    margin: 0 0 14px;
  }

  .feat-title {
    font-size: 2rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--color-ink, #0B1C30);
    margin: 0 0 16px;
    text-wrap: balance;
  }

  .feat-desc {
    color: var(--color-muted, #6b7280);
    line-height: 1.75;
    font-size: 1rem;
    margin: 0 0 28px;
  }

  .feat-bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .feat-bullets li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    color: var(--color-ink, #0B1C30);
  }

  .feat-check {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-primary, #1DB48B);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
    color: #fff;
    flex-shrink: 0;
  }

  .feat-visual {
    background: #F3F4F6;
    min-height: 460px;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .feat-card {
      grid-template-columns: 1fr;
      min-height: auto;
    }

    .feat-card--flip .feat-text { order: 0; }
    .feat-card--flip .feat-visual { order: 1; }

    .feat-text {
      padding: 36px 28px 28px;
    }

    .feat-title {
      font-size: 1.5rem;
    }

    .feat-visual {
      min-height: 160px;
    }
  }
</style>
