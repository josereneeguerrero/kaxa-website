---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section id="funciones" class="bg-surface py-16">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="text-center text-3xl font-extrabold text-ink">{t.features.title}</h2>
    <p class="mx-auto mt-3 max-w-xl text-center text-muted">{t.features.subtitle}</p>
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.features.items.map((item) => (
        <div class="rounded-card border border-surface-border bg-white p-6 shadow-card">
          <h3 class="text-lg font-bold text-ink">{item.title}</h3>
          <p class="mt-2 text-sm text-muted">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
