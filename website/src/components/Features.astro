---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const eyebrows = lang === 'es'
  ? ['REGISTRO', 'PRESUPUESTOS', 'METAS', 'DEUDAS', 'RESUMEN']
  : ['TRACKING', 'BUDGETS', 'GOALS', 'DEBTS', 'SUMMARY'];

const appFeatures = t.features.items;

const aiItem = lang === 'es'
  ? {
      eyebrow: 'INTELIGENCIA ARTIFICIAL',
      title: 'Registra con texto o voz — la IA lo entiende',
      description: 'Escribe "gasté 50 en almuerzo" y Kaxa lo categoriza, le asigna el monto y lo guarda. Sin formularios. Sin menús.',
      bullets: ['Entiende lenguaje natural', 'Categorización automática', 'Rápido como mandar un mensaje'],
    }
  : {
      eyebrow: 'ARTIFICIAL INTELLIGENCE',
      title: 'Log with text or voice — AI gets it',
      description: 'Type "spent 50 on lunch" and Kaxa categorizes it, assigns the amount, and saves it. No forms. No menus.',
      bullets: ['Understands natural language', 'Auto-categorization', 'As fast as sending a message'],
    };

const micIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>`;
---

<section id="funciones" class="bg-grain overflow-hidden">

  <!-- Header -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-16 sm:pt-24 pb-4 text-center">
    <h2 class="reveal text-3xl font-extrabold text-ink sm:text-4xl">{t.features.title}</h2>
    <p class="reveal mx-auto mt-3 max-w-xl text-muted" style="transition-delay:100ms">{t.features.subtitle}</p>
  </div>

  <!-- ── DESKTOP: sticky scroll ── -->
  <div class="features-desktop hidden lg:block mx-auto max-w-6xl px-6">

    <!-- Grid: left scrolls, right sticks -->
    <div style="display:grid;grid-template-columns:1fr 1fr;align-items:start;">

      <!-- LEFT: scrollable steps -->
      <div class="features-steps">
        {appFeatures.map((f, i) => (
          <div
            class="feature-step"
            data-index={String(i)}
            style="height:100vh;display:flex;align-items:center;"
          >
            <div style="max-width:380px;padding-right:32px;">
              <p class={`step-eyebrow text-xs font-extrabold uppercase tracking-widest mb-3 text-primary`}>
                {eyebrows[i]}
              </p>
              <h3 class="step-title text-[1.75rem] font-extrabold text-ink leading-snug mb-4" style="text-wrap:balance">
                {f.title}
              </h3>
              <p class="step-desc text-muted leading-relaxed mb-6">{f.description}</p>
              <ul class="step-bullets space-y-3">
                {f.bullets?.map((b: string) => (
                  <li class="flex items-center gap-3 text-sm text-ink/80">
                    <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white bg-primary">✓</span>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- RIGHT: sticky phone + dots -->
      <div style="position:sticky;top:0;height:100vh;display:flex;align-items:center;justify-content:center;gap:28px;">

        <!-- Dots track -->
        <div style="display:flex;flex-direction:column;gap:18px;align-items:center;">
          {appFeatures.map((_, i) => (
            <div
              class="feat-dot"
              data-dot={String(i)}
            ></div>
          ))}
        </div>

        <!-- Phone frame -->
        <div class="phone-frame">
          <!-- Bezel -->
          <div class="phone-bezel">
            <!-- Dynamic island -->
            <div class="phone-island"></div>
            <!-- Screen -->
            <div class="phone-screen-wrap">
              {appFeatures.map((f, i) => (
                <img
                  src={f.screenshot}
                  alt={f.title}
                  class="phone-screen"
                  data-screen={String(i)}
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
              ))}
              <!-- Glare -->
              <div class="phone-glare"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- ── AI FEATURE: full-width banner ── -->
  <div class="hidden lg:block mx-auto max-w-6xl px-6 pb-24">
    <div class="ai-banner reveal">
      <div class="ai-banner-left">
        <p class="text-xs font-extrabold uppercase tracking-widest mb-3 text-emerald-500">{aiItem.eyebrow}</p>
        <h3 class="text-[1.75rem] font-extrabold text-white leading-snug mb-4" style="text-wrap:balance">{aiItem.title}</h3>
        <p class="text-white/70 leading-relaxed mb-6">{aiItem.description}</p>
        <ul class="space-y-3">
          {aiItem.bullets.map((b) => (
            <li class="flex items-center gap-3 text-sm text-white/80">
              <span class="flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-emerald-900 bg-emerald-400">✓</span>
              {b}
            </li>
          ))}
        </ul>
      </div>
      <div class="ai-banner-right">
        <div class="ai-orb">
          <div class="ai-ring r1"></div>
          <div class="ai-ring r2"></div>
          <div class="ai-ring r3"></div>
          <div class="ai-icon">
            <Fragment set:html={micIcon} />
          </div>
        </div>
        <p class="ai-quote">{lang === 'es' ? '"gasté 50 en el almuerzo"' : '"spent 50 on lunch"'}</p>
        <div class="ai-bars">
          {[14, 22, 32, 22, 14].map((h) => (
            <div class="ai-bar" style={`height:${h}px`}></div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ── MOBILE: stacked ── -->
  <div class="lg:hidden mx-auto max-w-sm px-4 pb-16 pt-8 space-y-14">
    {appFeatures.map((f, i) => (
      <div class="reveal" style={`transition-delay:${i * 60}ms`}>
        <div style="border-radius:32px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.16);margin-bottom:24px;aspect-ratio:9/19.5;max-height:380px;">
          <img
            src={f.screenshot}
            alt={f.title}
            style="width:100%;height:100%;object-fit:cover;object-position:top;display:block;"
            loading="lazy"
          />
        </div>
        <p class="text-xs font-extrabold uppercase tracking-widest mb-2 text-primary">{eyebrows[i]}</p>
        <h3 class="text-xl font-extrabold text-ink mb-3 leading-snug">{f.title}</h3>
        <p class="text-muted text-sm leading-relaxed mb-4">{f.description}</p>
        <ul class="space-y-2">
          {f.bullets?.map((b: string) => (
            <li class="flex items-center gap-2 text-sm text-ink/70">
              <span class="flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white bg-primary">✓</span>
              {b}
            </li>
          ))}
        </ul>
      </div>
    ))}
    <!-- AI mobile -->
    <div class="reveal ai-banner-mobile">
      <p class="text-xs font-extrabold uppercase tracking-widest mb-2 text-emerald-500">{aiItem.eyebrow}</p>
      <h3 class="text-xl font-extrabold text-white mb-3 leading-snug">{aiItem.title}</h3>
      <p class="text-white/70 text-sm leading-relaxed">{aiItem.description}</p>
    </div>
  </div>

</section>

<script>
  const steps   = document.querySelectorAll<HTMLElement>('.feature-step');
  const screens = document.querySelectorAll<HTMLElement>('.phone-screen');
  const dots    = document.querySelectorAll<HTMLElement>('.feat-dot');

  if (steps.length === 0) return;

  let active = -1;

  const activate = (i: number) => {
    if (i === active) return;
    active = i;

    // screens
    screens.forEach((s, idx) => {
      s.style.opacity = idx === i ? '1' : '0';
    });

    // text
    steps.forEach((step, idx) => {
      step.classList.toggle('is-active', idx === i);
    });

    // dots
    dots.forEach((dot, idx) => {
      dot.classList.toggle('dot-active', idx === i);
    });
  };

  // init immediately
  activate(0);

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          activate(Number((e.target as HTMLElement).dataset.index ?? 0));
        }
      });
    },
    { threshold: 0, rootMargin: '-45% 0px -45% 0px' }
  );

  steps.forEach((s) => observer.observe(s));
</script>

<style>
  /* ── Phone frame ── */
  .phone-frame {
    width: 256px;
    height: 536px;
    position: relative;
    flex-shrink: 0;
  }
  .phone-bezel {
    position: absolute;
    inset: 0;
    border-radius: 46px;
    background: linear-gradient(160deg, #1e2028 0%, #111318 60%);
    box-shadow:
      0 0 0 1.5px rgba(255,255,255,0.1),
      inset 0 0 0 1px rgba(0,0,0,0.6),
      0 32px 80px rgba(0,0,0,0.5),
      0 8px 20px rgba(0,0,0,0.35);
  }
  .phone-island {
    position: absolute;
    top: 13px;
    left: 50%;
    transform: translateX(-50%);
    width: 84px;
    height: 24px;
    background: #0a0b0e;
    border-radius: 20px;
    z-index: 10;
    box-shadow: inset 0 1px 3px rgba(0,0,0,0.8);
  }
  .phone-screen-wrap {
    position: absolute;
    inset: 9px;
    border-radius: 38px;
    overflow: hidden;
    background: #f0f2f7;
  }
  .phone-screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: opacity 0.5s ease;
    opacity: 0;
  }
  .phone-screen[data-screen="0"] { opacity: 1; }
  .phone-glare {
    position: absolute;
    inset: 0;
    background: linear-gradient(130deg, rgba(255,255,255,0.07) 0%, transparent 50%);
    pointer-events: none;
    z-index: 20;
    border-radius: 38px;
  }

  /* ── Progress dots ── */
  .feat-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: rgba(0,0,0,0.15);
    transition: width 0.3s ease, height 0.3s ease, background 0.3s ease, border-radius 0.3s ease;
    flex-shrink: 0;
  }
  .feat-dot.dot-active {
    width: 7px;
    height: 28px;
    border-radius: 4px;
    background: var(--color-primary, #1DB48B);
  }

  /* ── Step text animations ── */
  .feature-step .step-eyebrow,
  .feature-step .step-title,
  .feature-step .step-desc,
  .feature-step .step-bullets {
    opacity: 0.2;
    transform: translateY(14px);
    transition: opacity 0.5s ease, transform 0.5s ease;
    will-change: opacity, transform;
  }
  .feature-step.is-active .step-eyebrow { opacity: 1; transform: translateY(0); }
  .feature-step.is-active .step-title   { opacity: 1; transform: translateY(0); transition-delay: 0.07s; }
  .feature-step.is-active .step-desc    { opacity: 1; transform: translateY(0); transition-delay: 0.14s; }
  .feature-step.is-active .step-bullets { opacity: 1; transform: translateY(0); transition-delay: 0.21s; }

  /* ── AI Banner ── */
  .ai-banner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 48px;
    align-items: center;
    background: linear-gradient(135deg, #064e3b 0%, #065f46 50%, #047857 100%);
    border-radius: 28px;
    padding: 56px 48px;
    margin-top: 8px;
  }
  .ai-banner-right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .ai-orb {
    position: relative;
    width: 120px;
    height: 120px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ai-ring {
    position: absolute;
    border-radius: 50%;
    border: 1.5px solid rgba(255,255,255,0.18);
    animation: ai-pulse 2.4s ease-in-out infinite;
  }
  .r1 { width: 120px; height: 120px; }
  .r2 { width: 88px;  height: 88px;  animation-delay: 0.4s; }
  .r3 { width: 60px;  height: 60px;  animation-delay: 0.8s; border-color: rgba(255,255,255,0.28); }
  .ai-icon {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    backdrop-filter: blur(4px);
  }
  .ai-quote {
    color: rgba(255,255,255,0.75);
    font-size: 13px;
    font-weight: 500;
    font-style: italic;
    text-align: center;
    max-width: 160px;
    line-height: 1.5;
  }
  .ai-bars {
    display: flex;
    gap: 5px;
    align-items: center;
  }
  .ai-bar {
    width: 5px;
    background: rgba(255,255,255,0.55);
    border-radius: 3px;
    animation: bar-wave 1.1s ease-in-out infinite;
    transform-origin: center;
  }
  .ai-bar:nth-child(1) { animation-delay: 0s; }
  .ai-bar:nth-child(2) { animation-delay: 0.15s; }
  .ai-bar:nth-child(3) { animation-delay: 0.3s; }
  .ai-bar:nth-child(4) { animation-delay: 0.15s; }
  .ai-bar:nth-child(5) { animation-delay: 0s; }

  .ai-banner-mobile {
    background: linear-gradient(135deg, #064e3b, #047857);
    border-radius: 24px;
    padding: 32px 24px;
  }

  @keyframes ai-pulse {
    0%, 100% { transform: scale(1);    opacity: 0.4; }
    50%       { transform: scale(1.1); opacity: 0.1; }
  }
  @keyframes bar-wave {
    0%, 100% { transform: scaleY(0.5); opacity: 0.5; }
    50%       { transform: scaleY(1);   opacity: 1; }
  }
</style>
