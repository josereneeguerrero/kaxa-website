---
import Icon, { type IconName } from './Icon.astro';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const stepIcons: IconName[] = ['pencil', 'wallet', 'chart-bar'];
---
<section id="como-funciona" class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <h2 class="reveal text-center text-3xl font-extrabold text-ink">{t.howItWorks.title}</h2>
  <p class="reveal mx-auto mt-3 max-w-xl text-center text-muted" style="transition-delay: 100ms">
    {t.howItWorks.subtitle}
  </p>
  <div class="mt-12 grid gap-8 md:grid-cols-3">
    {t.howItWorks.steps.map((step, i) => (
      <div
        class="reveal group rounded-card border border-surface-border bg-surface p-6 shadow-card transition hover:-translate-y-1 hover:shadow-lg"
        style={`transition-delay: ${i * 120}ms`}
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-btn bg-primary text-white transition group-hover:scale-110">
          <Icon name={stepIcons[i]} class="h-6 w-6" />
        </div>
        <div class="mt-4 flex items-center gap-2">
          <span class="text-sm font-extrabold text-primary">{step.number}</span>
          <h3 class="text-lg font-bold text-ink">{step.title}</h3>
        </div>
        <p class="mt-2 text-sm text-muted">{step.description}</p>
      </div>
    ))}
  </div>
</section>
