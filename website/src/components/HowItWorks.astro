---
import Icon, { type IconName } from './Icon.astro';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const stepIcons: IconName[] = ['pencil', 'wallet', 'chart-bar'];
const stepNums = ['01', '02', '03'];
---

<section id="como-funciona" class="relative mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-24">
  <h2 class="reveal text-center text-3xl font-extrabold text-ink sm:text-4xl">{t.howItWorks.title}</h2>
  <p class="reveal mx-auto mt-3 max-w-xl text-center text-muted" style="transition-delay: 100ms">
    {t.howItWorks.subtitle}
  </p>

  <div class="relative mt-16 grid gap-8 md:grid-cols-3">
    {/* Connecting line — desktop only */}
    <div
      class="absolute left-0 right-0 hidden h-px bg-surface-border md:block"
      style="top: 28px; left: calc(16.66% + 14px); right: calc(16.66% + 14px);"
      aria-hidden="true"
    ></div>

    {t.howItWorks.steps.map((step, i) => (
      <div
        class="reveal flex flex-col items-center text-center"
        style={`transition-delay: ${i * 120}ms`}
      >
        {/* Step number circle */}
        <div class="relative flex h-14 w-14 items-center justify-center rounded-full border-2 border-primary bg-white z-10 shadow-sm">
          <span class="text-sm font-extrabold text-primary">{stepNums[i]}</span>
        </div>

        {/* Icon + content */}
        <div class="mt-6 flex flex-col items-center">
          <div class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <Icon name={stepIcons[i]} class="h-5 w-5" />
          </div>
          <h3 class="mt-3 text-lg font-bold text-ink">{step.title}</h3>
          <p class="mt-2 max-w-[220px] text-sm leading-relaxed text-muted">{step.description}</p>
        </div>
      </div>
    ))}
  </div>
</section>
