---
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = lang === 'es' ? {
  title: 'Así de simple.',
  subtitle: 'Tres cosas que pasan cada vez que abres Kaxa.',
  steps: [
    {
      title: 'Di lo que gastaste',
      desc: 'Habla o escribe en lenguaje natural. Kaxa detecta el monto, la categoría y lo registra. Sin formularios, sin menús.',
    },
    {
      title: 'Todo en un vistazo',
      desc: 'Ve cuánto llevas en cada categoría, qué falta para el límite y cuáles se están pasando — sin abrir una hoja de cálculo.',
    },
    {
      title: 'Mira tu dinero moverse',
      desc: 'Cada bolsillo refleja un objetivo real. Ve el agua subir con cada aporte. Finanzas que puedes sentir.',
    },
  ],
} : {
  title: 'That simple.',
  subtitle: 'Three things that happen every time you open Kaxa.',
  steps: [
    {
      title: 'Say what you spent',
      desc: 'Speak or type naturally. Kaxa detects the amount, category and saves it. No forms, no menus.',
    },
    {
      title: 'Everything at a glance',
      desc: 'See how much you\'ve spent per category, what\'s left before the limit, and which ones are over — no spreadsheet needed.',
    },
    {
      title: 'Watch your money move',
      desc: 'Each pocket reflects a real goal. Watch the water rise with every contribution. Finances you can feel.',
    },
  ],
};

const budgets = lang === 'es'
  ? [
      { emoji: '🍔', bg: '#dcfce7', color: '#16a34a', barColor: '#16a34a', name: 'Comida',          current: 260, limit: 500,  pct: 52, pctColor: '#16a34a' },
      { emoji: '🎮', bg: '#fee2e2', color: '#dc2626', barColor: '#f59e0b', name: 'Entretenimiento', current: 280, limit: 300,  pct: 93, pctColor: '#d97706', warn: true },
      { emoji: '✈️', bg: '#e0f2fe', color: '#0284c7', barColor: '#0284c7', name: 'Meta viaje',       current: 800, limit: 2000, pct: 40, pctColor: '#0284c7' },
    ]
  : [
      { emoji: '🍔', bg: '#dcfce7', color: '#16a34a', barColor: '#16a34a', name: 'Food',          current: 260, limit: 500,  pct: 52, pctColor: '#16a34a' },
      { emoji: '🎮', bg: '#fee2e2', color: '#dc2626', barColor: '#f59e0b', name: 'Entertainment', current: 280, limit: 300,  pct: 93, pctColor: '#d97706', warn: true },
      { emoji: '✈️', bg: '#e0f2fe', color: '#0284c7', barColor: '#0284c7', name: 'Travel goal',   current: 800, limit: 2000, pct: 40, pctColor: '#0284c7' },
    ];

const pills = [
  { emoji: '🎮', fillColor: '#b5a8e8', bg: '#f5f3ff', fill: 50, pillStyle: 'background:#f5f3ff;box-shadow:0 2px 12px rgba(0,0,0,.07),inset 0 0 0 1px rgba(0,0,0,.05)', pctColor: '#7c6fcd' },
  { emoji: '❤️', fillColor: '#d4a520', bg: '#fffceb', fill: 45, pillStyle: 'background:#fffceb;box-shadow:0 0 0 2px #d4a520,0 2px 12px rgba(0,0,0,.07)',               pctColor: '#d4a520' },
  { emoji: '🍔', fillColor: '#6ecba0', bg: '#f0fdf6', fill: 22, pillStyle: 'background:#f0fdf6;box-shadow:0 2px 12px rgba(0,0,0,.07),inset 0 0 0 1px rgba(0,0,0,.05)', pctColor: '#059669' },
];
---

<section id="como-funciona" class="hiw-section">
  <div class="hiw-header reveal">
    <h2 class="hiw-title">{copy.title}</h2>
    <p class="hiw-sub">{copy.subtitle}</p>
  </div>

  <div class="hiw-grid">

    <!-- ── ROW 1: demos ── -->
    <div class="hiw-demo hiw-demo-1 reveal" id="hiw-demo-1">
      <div class="hd1-voice" id="hd1-rec">
        <div class="hd1-mic-wrap">
          <div class="hd1-ring hd1-r1"></div>
          <div class="hd1-ring hd1-r2"></div>
          <div class="hd1-mic">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="22"/>
            </svg>
          </div>
        </div>
        <div class="hd1-bars">
          {[5,12,20,28,20,12,5,12,20,12,5].map((h: number) => (
            <div class="hd1-bar" style={`height:${h}px`}></div>
          ))}
        </div>
        <p class="hd1-phrase" data-phrase={lang === 'es' ? 'Gasté 45$ en el supermercado' : 'I spent $45 at the supermarket'}><span id="hd1-text"></span><span class="hd1-cursor">|</span></p>
      </div>
      <div class="hd1-card" id="hd1-card">
        <div class="hd1-icon">🛒</div>
        <div class="hd1-center">
          <p class="hd1-cat">{lang === 'es' ? 'Supermercado' : 'Groceries'}</p>
          <p class="hd1-sub">10:22 · {lang === 'es' ? 'Compras del mes' : 'Monthly groceries'}</p>
        </div>
        <div class="hd1-right">
          <p class="hd1-amount">− $45.00</p>
          <div class="hd1-chip">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/>
            </svg>
            <span class="hd1-chip-lbl">{lang === 'es' ? 'Efectivo' : 'Cash'}</span>
          </div>
        </div>
      </div>
    </div>

    <div class="hiw-demo hiw-demo-2 reveal" id="hiw-demo-2" style="transition-delay:100ms">
      <div class="hd2-card">
        {budgets.map((b) => (
          <div class="hd2-row">
            <div class="hd2-icon" style={`background:${b.bg}`}>{b.emoji}</div>
            <div class="hd2-body">
              <div class="hd2-top">
                <span class="hd2-name">{b.name}</span>
                <span class="hd2-pct" style={`color:${b.pctColor}`}>{b.pct}%</span>
              </div>
              <div class="hd2-amounts">
                <span class="hd2-cur">${b.current}</span>
                <span class="hd2-lim">/ ${b.limit}</span>
              </div>
              <div class="hd2-track">
                <div class="hd2-fill" data-pct={String(b.pct)} style={`background:${b.barColor};width:0%`}></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hiw-demo hiw-demo-3 reveal" id="hiw-demo-3" style="transition-delay:200ms">
      <div class="hd3-pills">
        {pills.map((p) => (
          <div class="hd3-wrap">
            <div class="hd3-pill" style={p.pillStyle}>
              <div class="hd3-water" data-fill={String(p.fill)} style={`background:${p.fillColor};height:0%`}>
                <div class="hd3-wave" style={`background:${p.fillColor}`}></div>
              </div>
              <span class="hd3-emoji">{p.emoji}</span>
            </div>
            <p class="hd3-pct" style={`color:${p.pctColor}`}>{p.fill}%</p>
          </div>
        ))}
      </div>
    </div>

    <!-- ── ROW 2: texts (always aligned at same baseline) ── -->
    <div class="hiw-text reveal">
      <h3 class="hiw-step-title">{copy.steps[0].title}</h3>
      <p class="hiw-step-desc">{copy.steps[0].desc}</p>
    </div>
    <div class="hiw-text reveal" style="transition-delay:100ms">
      <h3 class="hiw-step-title">{copy.steps[1].title}</h3>
      <p class="hiw-step-desc">{copy.steps[1].desc}</p>
    </div>
    <div class="hiw-text reveal" style="transition-delay:200ms">
      <h3 class="hiw-step-title">{copy.steps[2].title}</h3>
      <p class="hiw-step-desc">{copy.steps[2].desc}</p>
    </div>

  </div>
</section>

<script>
(function () {
  let started = false;

  /* ── Demo 1 ── */
  function runDemo1() {
    const rec    = document.getElementById('hd1-rec')    as HTMLElement | null;
    const card   = document.getElementById('hd1-card')   as HTMLElement | null;
    const textEl = document.getElementById('hd1-text')   as HTMLElement | null;
    if (!rec || !card || !textEl) return;

    const phrase = (document.querySelector('.hd1-phrase') as HTMLElement | null)?.dataset.phrase ?? 'Almuerzo, 85 lempiras';
    let ti: ReturnType<typeof setInterval>;

    function reset() {
      rec.style.cssText  += ';opacity:1;transform:translateY(0);transition:none';
      card.style.cssText += ';opacity:0;transform:translateY(14px);transition:none';
      textEl.textContent  = '';
    }

    function run() {
      reset();
      let i = 0;
      clearInterval(ti);
      // small delay so reset is applied before animation
      setTimeout(() => {
        ti = setInterval(() => {
          textEl.textContent += phrase[i++];
          if (i >= phrase.length) {
            clearInterval(ti);
            setTimeout(() => {
              rec.style.transition  = 'opacity .4s ease, transform .4s ease';
              rec.style.opacity     = '0';
              rec.style.transform   = 'translateY(-10px)';
              card.style.transition = 'opacity .45s ease, transform .45s ease';
              card.style.opacity    = '1';
              card.style.transform  = 'translateY(0)';
              setTimeout(run, 4500);
            }, 500);
          }
        }, 55);
      }, 30);
    }
    run();
  }

  /* ── Demo 2: budget bars ── */
  function runDemo2() {
    const fills = Array.from(document.querySelectorAll<HTMLElement>('.hd2-fill'));
    if (!fills.length) return;

    function run() {
      fills.forEach(f => {
        f.style.transition = 'none';
        f.style.width = '0%';
      });
      fills.forEach((f, i) => {
        setTimeout(() => {
          f.style.transition = 'width 1s cubic-bezier(.4,0,.2,1)';
          f.style.width = (f.dataset.pct ?? '50') + '%';
        }, 300 + i * 350);
      });
      setTimeout(run, 5000);
    }
    run();
  }

  /* ── Demo 3: water pills ── */
  function runDemo3() {
    const waters = Array.from(document.querySelectorAll<HTMLElement>('.hd3-water'));
    if (!waters.length) return;

    function run() {
      waters.forEach(w => {
        w.style.transition = 'none';
        w.style.height = '0%';
      });
      waters.forEach((w, i) => {
        setTimeout(() => {
          w.style.transition = 'height 2s cubic-bezier(.4,0,.2,1)';
          w.style.height = (w.dataset.fill ?? '40') + '%';
        }, 150 + i * 250);
      });
      setTimeout(run, 5500);
    }
    run();
  }

  const section = document.getElementById('como-funciona');
  if (!section) return;
  const obs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !started) {
      started = true;
      obs.disconnect();
      runDemo1();
      runDemo2();
      runDemo3();
    }
  }, { threshold: 0.15 });
  obs.observe(section);
})();
</script>

<style>
  /* ── Section ── */
  .hiw-section { background: #f5f7f5; padding: 96px 24px; }
  .hiw-header  { text-align: center; margin-bottom: 72px; }
  .hiw-title   { font-size: clamp(2rem,4vw,3rem); font-weight:900; color:#0d1512; letter-spacing:-.02em; margin-bottom:12px; }
  .hiw-sub     { font-size:1.05rem; color:#6b7280; max-width:420px; margin:0 auto; line-height:1.6; }

  .hiw-grid {
    max-width: 1100px; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    grid-template-rows: auto auto;
    column-gap: 48px;
    row-gap: 0;
    align-items: end; /* demos bottom-align in row 1 so texts start at same Y */
  }
  .hiw-demo   { align-self:end; padding-bottom:32px; }
  .hiw-text   { display:flex; flex-direction:column; align-items:center; align-self:start; }
  .hiw-step-title { font-size:1.1rem; font-weight:800; color:#0d1512; margin:0 0 8px; text-align:center; }
  .hiw-step-desc  { font-size:14px; color:#6b7280; line-height:1.7; text-align:center; max-width:240px; margin:0; }

  @media (max-width:768px) {
    .hiw-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: 0;
    }
    .hiw-section { padding:64px 20px; }
    /* interleave demo+text per feature */
    .hiw-demo-1 { order:1; }
    .hiw-text:nth-child(4) { order:2; padding-bottom:48px; }
    .hiw-demo-2 { order:3; }
    .hiw-text:nth-child(5) { order:4; padding-bottom:48px; }
    .hiw-demo-3 { order:5; }
    .hiw-text:nth-child(6) { order:6; }
    .hiw-demo   { padding-bottom:24px; }
  }

  /* ── Demo shell ── */
  .hiw-demo   { width:100%; display:flex; align-items:center; justify-content:center; }
  .hiw-demo-1 {
    position:relative; height:160px; max-width:260px;
    background:#fff; border-radius:16px;
    box-shadow:0 2px 16px rgba(0,0,0,.07), 0 1px 4px rgba(0,0,0,.04);
    overflow:hidden;
  }
  .hiw-demo-2 { }
  .hiw-demo-3 { height:220px; }

  /* ══ DEMO 1 ══ */
  .hd1-voice {
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
  }
  .hd1-mic-wrap {
    position:relative; width:52px; height:52px;
    display:flex; align-items:center; justify-content:center;
  }
  .hd1-ring {
    position:absolute; border-radius:50%;
    border:1.5px solid rgba(29,180,139,.3);
    animation:hring 2s ease-in-out infinite;
  }
  .hd1-r1 { width:52px; height:52px; }
  .hd1-r2 { width:36px; height:36px; animation-delay:.5s; }
  @keyframes hring { 0%,100%{transform:scale(1);opacity:.4} 50%{transform:scale(1.18);opacity:.1} }
  .hd1-mic {
    width:36px; height:36px; border-radius:50%;
    background:#1DB48B; color:#fff;
    display:flex; align-items:center; justify-content:center;
    position:relative; z-index:1;
    box-shadow:0 0 16px rgba(29,180,139,.3);
  }
  .hd1-bars   { display:flex; align-items:center; gap:2.5px; height:30px; }
  .hd1-bar    {
    width:2.5px; border-radius:2px; background:#1DB48B; opacity:.7;
    animation:hwbar .9s ease-in-out infinite; transform-origin:center;
  }
  .hd1-bar:nth-child(1){animation-delay:0s}   .hd1-bar:nth-child(2){animation-delay:.07s}
  .hd1-bar:nth-child(3){animation-delay:.14s}  .hd1-bar:nth-child(4){animation-delay:.21s}
  .hd1-bar:nth-child(5){animation-delay:.14s}  .hd1-bar:nth-child(6){animation-delay:.07s}
  .hd1-bar:nth-child(7){animation-delay:0s}    .hd1-bar:nth-child(8){animation-delay:.07s}
  .hd1-bar:nth-child(9){animation-delay:.14s}  .hd1-bar:nth-child(10){animation-delay:.07s}
  .hd1-bar:nth-child(11){animation-delay:0s}
  @keyframes hwbar { 0%,100%{transform:scaleY(.25);opacity:.25} 50%{transform:scaleY(1);opacity:.9} }
  .hd1-phrase { font-size:11px; color:#374151; font-weight:500; height:16px; display:flex; align-items:center; gap:1px; }
  .hd1-cursor { animation:blink .8s infinite; color:#1DB48B; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  /* _SheetItemCard calco — KaxaColors exact */
  .hd1-card {
    position:absolute; inset:0;
    background:#F8F9FF; padding:12px 14px;
    display:flex; align-items:center; gap:12px;
    opacity:0; transform:translateY(14px);
  }
  .hd1-icon   {
    width:40px; height:40px; border-radius:11px; flex-shrink:0;
    background:rgba(34,197,94,0.15);
    display:flex; align-items:center; justify-content:center;
    font-size:21px;
  }
  .hd1-center { flex:1; min-width:0; }
  .hd1-cat    { font-size:14px; font-weight:700; color:#0B1C30; margin:0; }
  .hd1-sub    { font-size:12px; font-weight:500; color:#6C7A71; margin:0; }
  .hd1-right  { display:flex; flex-direction:column; align-items:flex-end; gap:5px; flex-shrink:0; }
  .hd1-amount { font-size:14px; font-weight:800; color:#EF4444; margin:0; }
  .hd1-chip   {
    display:flex; align-items:center; gap:3px;
    padding:3px 7px; border-radius:9999px;
    background:#fff; border:1px solid #BBCABF;
  }
  .hd1-chip-lbl { font-size:9.5px; font-weight:600; color:#6C7A71; }

  /* ══ DEMO 2 ══ */
  .hd2-card {
    width:220px; background:#fff; border-radius:16px;
    padding:14px; display:flex; flex-direction:column; gap:12px;
    box-shadow:0 4px 24px rgba(0,0,0,.08), 0 1px 3px rgba(0,0,0,.04);
  }
  .hd2-row    { display:flex; align-items:flex-start; gap:10px; }
  .hd2-icon   {
    width:36px; height:36px; border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    font-size:18px; flex-shrink:0; margin-top:1px;
  }
  .hd2-body   { flex:1; min-width:0; }
  .hd2-top    { display:flex; justify-content:space-between; align-items:center; margin-bottom:1px; }
  .hd2-name   { font-size:11px; font-weight:800; color:#111; }
  .hd2-pct    { font-size:11px; font-weight:700; }
  .hd2-amounts{ display:flex; align-items:baseline; gap:3px; margin-bottom:5px; }
  .hd2-cur    { font-size:12px; font-weight:700; color:#0d1512; }
  .hd2-lim    { font-size:10px; color:#9ca3af; }
  .hd2-track  { height:4px; background:#f3f4f6; border-radius:2px; overflow:hidden; }
  .hd2-fill   { height:100%; border-radius:2px; width:0%; }

  /* ══ DEMO 3 ══ */
  .hd3-pills  { display:flex; gap:14px; align-items:flex-end; }
  .hd3-wrap   { display:flex; flex-direction:column; align-items:center; gap:6px; }
  .hd3-pill   {
    width:48px; height:175px; border-radius:9999px;
    position:relative; overflow:hidden;
  }
  .hd3-water  {
    position:absolute; bottom:0; left:0; right:0;
    /* no bottom border-radius — we clip via overflow:hidden on pill */
  }
  .hd3-wave   {
    position:absolute; top:-12px; left:-40%;
    width:180%; height:24px; border-radius:50%;
    animation:hwave 2.4s ease-in-out infinite;
  }
  @keyframes hwave {
    0%,100% { transform:translateX(0) scaleY(.8); }
    50%      { transform:translateX(15%) scaleY(1); }
  }
  .hd3-emoji  {
    position:absolute; bottom:10px; left:50%;
    transform:translateX(-50%);
    font-size:22px; z-index:2;
  }
  .hd3-pct    { font-size:11px; font-weight:800; margin:0; }
</style>
