---
import type { Lang } from '../i18n/routes';
interface Props { lang: Lang; }
const { lang } = Astro.props;

const copy = lang === 'es' ? {
  title: 'Así de simple.',
  subtitle: 'Tres cosas que pasan cada vez que abres Kaxa.',
  steps: [
    {
      title: 'Di lo que gastaste',
      desc: 'Habla o escribe en lenguaje natural. Kaxa detecta el monto, la categoría y lo registra. Sin formularios, sin menús.',
    },
    {
      title: 'Todo en un vistazo',
      desc: 'Ve cuánto llevas en cada categoría, qué falta para el límite y cuáles se están pasando — sin abrir una hoja de cálculo.',
    },
    {
      title: 'Organiza con bolsillos',
      desc: 'Divide tu dinero en efectivo, tarjeta, billetera digital y banco. Siempre sabes exactamente cuánto tienes en cada lugar.',
    },
  ],
} : {
  title: 'That simple.',
  subtitle: 'Three things that happen every time you open Kaxa.',
  steps: [
    {
      title: 'Say what you spent',
      desc: 'Speak or type naturally. Kaxa detects the amount, category and saves it. No forms, no menus.',
    },
    {
      title: 'Everything at a glance',
      desc: 'See how much you\'ve spent per category, what\'s left before the limit, and which ones are over — no spreadsheet needed.',
    },
    {
      title: 'Organize with pockets',
      desc: 'Split your money across cash, card, digital wallet and bank. Always know exactly how much you have in each place.',
    },
  ],
};

const budgets = lang === 'es'
  ? [
      { emoji: '🍔', bg: '#dcfce7', color: '#16a34a', barColor: '#16a34a', name: 'Comida',          current: 260, limit: 500,  pct: 52, pctColor: '#16a34a' },
      { emoji: '🎮', bg: '#fee2e2', color: '#dc2626', barColor: '#f59e0b', name: 'Entretenimiento', current: 280, limit: 300,  pct: 93, pctColor: '#d97706', warn: true },
      { emoji: '✈️', bg: '#e0f2fe', color: '#0284c7', barColor: '#0284c7', name: 'Meta viaje',       current: 800, limit: 2000, pct: 40, pctColor: '#0284c7' },
    ]
  : [
      { emoji: '🍔', bg: '#dcfce7', color: '#16a34a', barColor: '#16a34a', name: 'Food',          current: 260, limit: 500,  pct: 52, pctColor: '#16a34a' },
      { emoji: '🎮', bg: '#fee2e2', color: '#dc2626', barColor: '#f59e0b', name: 'Entertainment', current: 280, limit: 300,  pct: 93, pctColor: '#d97706', warn: true },
      { emoji: '✈️', bg: '#e0f2fe', color: '#0284c7', barColor: '#0284c7', name: 'Travel goal',   current: 800, limit: 2000, pct: 40, pctColor: '#0284c7' },
    ];

const bolsillos = [
  { id:'hd3-0', rgba:'245,158,11',  color:'#F59E0B', name: lang==='es'?'Efectivo':'Cash',    bal:'$320',   svgPath:'M3 8h18a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2zM3 8V6a2 2 0 0 1 2-2h6M17 14h.01' },
  { id:'hd3-1', rgba:'244,63,94',   color:'#F43F5E', name: lang==='es'?'Tarjeta':'Card',     bal:'$1,200', svgPath:'M2 5h20v14H2zM2 10h20M6 15h4' },
  { id:'hd3-2', rgba:'124,58,237',  color:'#7C3AED', name: lang==='es'?'B. Digital':'Digital',bal:'$85',  svgPath:'M17 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2zM12 18a1 1 0 1 0 0-2 1 1 0 0 0 0 2z' },
  { id:'hd3-3', rgba:'37,99,235',   color:'#2563EB', name: lang==='es'?'Banco':'Bank',       bal:'$2,400', svgPath:'M3 21h18M3 10h18M5 6l7-3 7 3M4 10v11M20 10v11M8 10v11M12 10v11M16 10v11' },
];
---

<section id="como-funciona" class="hiw-section">
  <div class="hiw-header reveal">
    <h2 class="hiw-title">{copy.title}</h2>
    <p class="hiw-sub">{copy.subtitle}</p>
  </div>

  <div class="hiw-grid">

    <!-- ── ROW 1: demos ── -->
    <div class="hiw-demo hiw-demo-1 reveal" id="hiw-demo-1">
      <div class="hd1-voice" id="hd1-rec">
        <div class="hd1-mic-wrap">
          <div class="hd1-ring hd1-r1"></div>
          <div class="hd1-ring hd1-r2"></div>
          <div class="hd1-mic">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
              <line x1="12" y1="19" x2="12" y2="22"/>
            </svg>
          </div>
        </div>
        <div class="hd1-bars">
          {[5,12,20,28,20,12,5,12,20,12,5].map((h: number) => (
            <div class="hd1-bar" style={`height:${h}px`}></div>
          ))}
        </div>
        <p class="hd1-phrase" data-phrase={lang === 'es' ? 'Gasté $45, me pagaron $100 hoy' : 'Spent $45, got paid $100 today'}><span id="hd1-text"></span><span class="hd1-cursor">|</span></p>
      </div>
      <!-- Dos cards: gasto + ingreso -->
      <div class="hd1-cards">
        <div class="hd1-card" id="hd1-card">
          <div class="hd1-icon" style="background:rgba(34,197,94,0.15)">🛒</div>
          <div class="hd1-center">
            <p class="hd1-cat">{lang === 'es' ? 'Supermercado' : 'Groceries'}</p>
            <p class="hd1-sub">10:22 · {lang === 'es' ? 'Compras del mes' : 'Monthly run'}</p>
          </div>
          <div class="hd1-right">
            <p class="hd1-amount" style="color:#EF4444">− $45.00</p>
            <div class="hd1-chip">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#F59E0B" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              <span class="hd1-chip-lbl">{lang === 'es' ? 'Efectivo' : 'Cash'}</span>
            </div>
          </div>
        </div>
        <div class="hd1-card" id="hd1-card2">
          <div class="hd1-icon" style="background:rgba(16,185,129,0.15)">💼</div>
          <div class="hd1-center">
            <p class="hd1-cat">{lang === 'es' ? 'Trabajo' : 'Work'}</p>
            <p class="hd1-sub">14:05 · {lang === 'es' ? 'Pago freelance' : 'Freelance pay'}</p>
          </div>
          <div class="hd1-right">
            <p class="hd1-amount" style="color:#10B981">+ $100.00</p>
            <div class="hd1-chip">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="#2563EB" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
              <span class="hd1-chip-lbl">{lang === 'es' ? 'Banco' : 'Bank'}</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="hiw-demo hiw-demo-2 reveal" id="hiw-demo-2" style="transition-delay:100ms">
      <div class="hd2-card">
        {budgets.map((b) => (
          <div class="hd2-row">
            <div class="hd2-icon" style={`background:${b.bg}`}>{b.emoji}</div>
            <div class="hd2-body">
              <div class="hd2-top">
                <span class="hd2-name">{b.name}</span>
                <span class="hd2-pct" style={`color:${b.pctColor}`}>{b.pct}%</span>
              </div>
              <div class="hd2-amounts">
                <span class="hd2-cur">${b.current}</span>
                <span class="hd2-lim">/ ${b.limit}</span>
              </div>
              <div class="hd2-track">
                <div class="hd2-fill" data-pct={String(b.pct)} style={`background:${b.barColor};width:0%`}></div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="hiw-demo hiw-demo-3 reveal" id="hiw-demo-3" style="transition-delay:200ms">
      <div class="hd3-card">
        <div class="hd3-box">
          <p class="hd3-header">{lang === 'es' ? 'Mis bolsillos' : 'My pockets'}</p>
          <div class="hd3-grid">
            {bolsillos.map((b) => (
              <div class="hd3-item" id={b.id} data-color={b.color} data-rgba={b.rgba}>
                <div class="hd3-circle" style={`background:rgba(${b.rgba},0.12)`}>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={b.color} stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d={b.svgPath}/>
                  </svg>
                </div>
                <div class="hd3-info">
                  <p class="hd3-name" style={`color:#6C7A71`}>{b.name}</p>
                  <p class="hd3-bal">{b.bal}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <!-- ── ROW 2: texts (always aligned at same baseline) ── -->
    <div class="hiw-text reveal">
      <h3 class="hiw-step-title">{copy.steps[0].title}</h3>
      <p class="hiw-step-desc">{copy.steps[0].desc}</p>
    </div>
    <div class="hiw-text reveal" style="transition-delay:100ms">
      <h3 class="hiw-step-title">{copy.steps[1].title}</h3>
      <p class="hiw-step-desc">{copy.steps[1].desc}</p>
    </div>
    <div class="hiw-text reveal" style="transition-delay:200ms">
      <h3 class="hiw-step-title">{copy.steps[2].title}</h3>
      <p class="hiw-step-desc">{copy.steps[2].desc}</p>
    </div>

  </div>
</section>

<script>
(function () {
  let started = false;

  /* ── Demo 1 ── */
  function runDemo1() {
    const rec    = document.getElementById('hd1-rec')    as HTMLElement | null;
    const card   = document.getElementById('hd1-card')   as HTMLElement | null;
    const card2  = document.getElementById('hd1-card2')  as HTMLElement | null;
    const textEl = document.getElementById('hd1-text')   as HTMLElement | null;
    if (!rec || !card || !textEl) return;

    const phrase = (document.querySelector('.hd1-phrase') as HTMLElement | null)?.dataset.phrase ?? 'Gasté $45, me pagaron $100 hoy';
    let ti: ReturnType<typeof setInterval>;

    function reset() {
      rec.style.cssText  += ';opacity:1;transform:translateY(0);transition:none';
      card.style.cssText += ';opacity:0;transform:translateY(10px);transition:none';
      if (card2) card2.style.cssText += ';opacity:0;transform:translateY(10px);transition:none';
      textEl.textContent = '';
    }

    function run() {
      reset();
      let i = 0;
      clearInterval(ti);
      setTimeout(() => {
        ti = setInterval(() => {
          textEl.textContent += phrase[i++];
          if (i >= phrase.length) {
            clearInterval(ti);
            setTimeout(() => {
              rec.style.transition = 'opacity .35s ease, transform .35s ease';
              rec.style.opacity    = '0';
              rec.style.transform  = 'translateY(-8px)';
              card.style.transition  = 'opacity .45s ease, transform .45s cubic-bezier(.34,1.56,.64,1)';
              card.style.opacity     = '1';
              card.style.transform   = 'translateY(0)';
              if (card2) {
                card2.style.transition = 'opacity .45s .08s ease, transform .45s .08s cubic-bezier(.34,1.56,.64,1)';
                card2.style.opacity    = '1';
                card2.style.transform  = 'translateY(0)';
              }
              setTimeout(run, 4000);
            }, 400);
          }
        }, 46);
      }, 30);
    }
    run();
  }

  /* ── Demo 2: budget bars ── */
  function runDemo2() {
    const fills = Array.from(document.querySelectorAll<HTMLElement>('.hd2-fill'));
    if (!fills.length) return;

    function run() {
      fills.forEach(f => {
        f.style.transition = 'none';
        f.style.width = '0%';
      });
      fills.forEach((f, i) => {
        setTimeout(() => {
          f.style.transition = 'width 1.1s cubic-bezier(.4,0,.2,1)';
          f.style.width = (f.dataset.pct ?? '50') + '%';
        }, 200 + i * 300);
      });
      setTimeout(run, 4800);
    }
    run();
  }

  /* ── Demo 3: bolsillo selection cycle ── */
  function runDemo3() {
    const items = Array.from(document.querySelectorAll<HTMLElement>('.hd3-item'));
    if (!items.length) return;
    let idx = 0;

    function select() {
      items.forEach((el, i) => {
        const rgba  = el.dataset.rgba  ?? '0,0,0';
        const color = el.dataset.color ?? '#000';
        const circle = el.querySelector<HTMLElement>('.hd3-circle');
        const name   = el.querySelector<HTMLElement>('.hd3-name');
        if (i === idx) {
          el.style.borderColor = color;
          el.style.background  = `rgba(${rgba},0.10)`;
          if (circle) circle.style.background = `rgba(${rgba},0.20)`;
          if (name)   name.style.color        = color;
        } else {
          el.style.borderColor = 'transparent';
          el.style.background  = '#F8F9FF';
          if (circle) circle.style.background = `rgba(${rgba},0.12)`;
          if (name)   name.style.color        = '#6C7A71';
        }
      });
      idx = (idx + 1) % items.length;
    }

    select();
    setInterval(select, 1200);
  }

  const section = document.getElementById('como-funciona');
  if (!section) return;
  const obs = new IntersectionObserver(entries => {
    if (entries[0].isIntersecting && !started) {
      started = true;
      obs.disconnect();
      runDemo1();
      runDemo2();
      runDemo3();
    }
  }, { threshold: 0.15 });
  obs.observe(section);
})();
</script>

<style>
  /* ── Section ── */
  .hiw-section { background: #f5f7f5; padding: 96px 24px; }
  .hiw-header  { text-align: center; margin-bottom: 72px; }
  .hiw-title   { font-size: clamp(2rem,4vw,3rem); font-weight:900; color:#0d1512; letter-spacing:-.02em; margin-bottom:12px; }
  .hiw-sub     { font-size:1.05rem; color:#6b7280; max-width:420px; margin:0 auto; line-height:1.6; }

  .hiw-grid {
    max-width: 1100px; margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3,1fr);
    grid-template-rows: auto auto;
    column-gap: 48px;
    row-gap: 0;
    align-items: start;
  }
  .hiw-demo   { align-self:start; padding-bottom:32px; }
  .hiw-text   { display:flex; flex-direction:column; align-items:center; align-self:start; }
  .hiw-step-title { font-size:1.1rem; font-weight:800; color:#0d1512; margin:0 0 8px; text-align:center; }
  .hiw-step-desc  { font-size:14px; color:#6b7280; line-height:1.7; text-align:center; max-width:240px; margin:0; }

  @media (max-width:768px) {
    .hiw-grid {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: 0;
    }
    .hiw-section { padding:64px 20px; }
    /* interleave demo+text per feature */
    .hiw-demo-1 { order:1; }
    .hiw-text:nth-child(4) { order:2; padding-bottom:48px; }
    .hiw-demo-2 { order:3; }
    .hiw-text:nth-child(5) { order:4; padding-bottom:48px; }
    .hiw-demo-3 { order:5; }
    .hiw-text:nth-child(6) { order:6; }
    .hiw-demo   { padding-bottom:24px; }
  }

  /* ── Demo shell ── */
  .hiw-demo   { width:100%; display:flex; align-items:flex-start; justify-content:center; }
  .hiw-demo-1 {
    position:relative; height:196px; width:260px; margin:0 auto;
    background:#fff; border-radius:16px;
    box-shadow:0 2px 16px rgba(0,0,0,.07), 0 1px 4px rgba(0,0,0,.04);
    overflow:hidden;
  }
  .hiw-demo-2 { }
  .hiw-demo-3 { }

  /* ══ DEMO 1 ══ */
  .hd1-voice {
    position:absolute; inset:0;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
  }
  .hd1-mic-wrap {
    position:relative; width:52px; height:52px;
    display:flex; align-items:center; justify-content:center;
  }
  .hd1-ring {
    position:absolute; border-radius:50%;
    border:1.5px solid rgba(29,180,139,.3);
    animation:hring 2s ease-in-out infinite;
  }
  .hd1-r1 { width:52px; height:52px; }
  .hd1-r2 { width:36px; height:36px; animation-delay:.5s; }
  @keyframes hring { 0%,100%{transform:scale(1);opacity:.4} 50%{transform:scale(1.18);opacity:.1} }
  .hd1-mic {
    width:36px; height:36px; border-radius:50%;
    background:#1DB48B; color:#fff;
    display:flex; align-items:center; justify-content:center;
    position:relative; z-index:1;
    box-shadow:0 0 16px rgba(29,180,139,.3);
  }
  .hd1-bars   { display:flex; align-items:center; gap:2.5px; height:30px; }
  .hd1-bar    {
    width:2.5px; border-radius:2px; background:#1DB48B; opacity:.7;
    animation:hwbar .9s ease-in-out infinite; transform-origin:center;
  }
  .hd1-bar:nth-child(1){animation-delay:0s}   .hd1-bar:nth-child(2){animation-delay:.07s}
  .hd1-bar:nth-child(3){animation-delay:.14s}  .hd1-bar:nth-child(4){animation-delay:.21s}
  .hd1-bar:nth-child(5){animation-delay:.14s}  .hd1-bar:nth-child(6){animation-delay:.07s}
  .hd1-bar:nth-child(7){animation-delay:0s}    .hd1-bar:nth-child(8){animation-delay:.07s}
  .hd1-bar:nth-child(9){animation-delay:.14s}  .hd1-bar:nth-child(10){animation-delay:.07s}
  .hd1-bar:nth-child(11){animation-delay:0s}
  @keyframes hwbar { 0%,100%{transform:scaleY(.25);opacity:.25} 50%{transform:scaleY(1);opacity:.9} }
  .hd1-phrase { font-size:11px; color:#374151; font-weight:500; height:16px; display:flex; align-items:center; gap:1px; }
  .hd1-cursor { animation:blink .8s infinite; color:#1DB48B; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }

  /* Two-card stack */
  .hd1-cards {
    position:absolute; inset:0;
    display:flex; flex-direction:column; justify-content:center; gap:8px; padding:12px;
  }
  .hd1-card {
    background:#F8F9FF; border-radius:12px; padding:9px 12px;
    display:flex; align-items:center; gap:10px;
    opacity:0; transform:translateY(10px);
  }
  .hd1-icon   {
    width:34px; height:34px; border-radius:9px; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    font-size:17px;
  }
  .hd1-center { flex:1; min-width:0; }
  .hd1-cat    { font-size:12px; font-weight:700; color:#0B1C30; margin:0; }
  .hd1-sub    { font-size:10px; font-weight:500; color:#6C7A71; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
  .hd1-right  { display:flex; flex-direction:column; align-items:flex-end; gap:4px; flex-shrink:0; }
  .hd1-amount { font-size:12px; font-weight:800; margin:0; }
  .hd1-chip   {
    display:flex; align-items:center; gap:3px;
    padding:2px 6px; border-radius:9999px;
    background:#fff; border:1px solid #BBCABF;
  }
  .hd1-chip-lbl { font-size:9px; font-weight:600; color:#6C7A71; }

  /* ══ DEMO 2 ══ */
  .hd2-card {
    width:220px; background:#fff; border-radius:16px;
    padding:14px; display:flex; flex-direction:column; gap:12px;
    box-shadow:0 4px 24px rgba(0,0,0,.08), 0 1px 3px rgba(0,0,0,.04);
  }
  .hd2-row    { display:flex; align-items:flex-start; gap:10px; }
  .hd2-icon   {
    width:36px; height:36px; border-radius:10px;
    display:flex; align-items:center; justify-content:center;
    font-size:18px; flex-shrink:0; margin-top:1px;
  }
  .hd2-body   { flex:1; min-width:0; }
  .hd2-top    { display:flex; justify-content:space-between; align-items:center; margin-bottom:1px; }
  .hd2-name   { font-size:11px; font-weight:800; color:#111; }
  .hd2-pct    { font-size:11px; font-weight:700; }
  .hd2-amounts{ display:flex; align-items:baseline; gap:3px; margin-bottom:5px; }
  .hd2-cur    { font-size:12px; font-weight:700; color:#0d1512; }
  .hd2-lim    { font-size:10px; color:#9ca3af; }
  .hd2-track  { height:4px; background:#f3f4f6; border-radius:2px; overflow:hidden; }
  .hd2-fill   { height:100%; border-radius:2px; width:0%; }

  /* ══ DEMO 3: bolsillos 2×2 grid (calco de _BolsillosPage) ══ */
  .hd3-card   {
    background:#fff; border-radius:16px; padding:16px;
    box-shadow:0 4px 24px rgba(0,0,0,.08), 0 1px 3px rgba(0,0,0,.04);
  }
  .hd3-box    { display:flex; flex-direction:column; align-items:center; gap:0; }
  .hd3-header { font-size:11px; color:#6C7A71; font-weight:500; margin:0 0 10px; }
  .hd3-grid   {
    display:grid; grid-template-columns:1fr 1fr; gap:8px; width:220px;
  }
  .hd3-item   {
    display:flex; align-items:center; gap:8px;
    padding:8px 10px; border-radius:12px;
    background:#F8F9FF; border:1.5px solid transparent;
    transition: border-color .3s ease, background .3s ease;
  }
  .hd3-circle {
    width:32px; height:32px; border-radius:50%; flex-shrink:0;
    display:flex; align-items:center; justify-content:center;
    transition: background .3s ease;
  }
  .hd3-info   { flex:1; min-width:0; }
  .hd3-name   { font-size:10px; font-weight:700; margin:0; transition: color .35s ease; }
  .hd3-bal    { font-size:13px; font-weight:800; color:#0B1C30; margin:0; }
</style>
