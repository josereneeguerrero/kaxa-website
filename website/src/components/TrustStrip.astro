---
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const pills = lang === 'es'
  ? [
      { icon: '🚫', text: 'Sin anuncios' },
      { icon: '🔒', text: 'Datos solo en tu dispositivo' },
      { icon: '✕', text: 'Cancela cuando quieras' },
      { icon: '✨', text: 'IA incluida' },
      { icon: '🎁', text: 'Gratis para empezar' },
    ]
  : [
      { icon: '🚫', text: 'No ads' },
      { icon: '🔒', text: 'Data stays on your device' },
      { icon: '✕', text: 'Cancel anytime' },
      { icon: '✨', text: 'AI included' },
      { icon: '🎁', text: 'Free to start' },
    ];
---

<div class="border-y border-surface-border bg-white py-3.5">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-center gap-x-6 gap-y-2 px-4 sm:px-6">
    {pills.map((pill) => (
      <span class="flex items-center gap-1.5 text-xs font-semibold text-ink/60">
        <span class="flex h-4 w-4 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-[9px] font-bold text-primary">✓</span>
        {pill.text}
      </span>
    ))}
  </div>
</div>
