---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6">
  <h2 class="text-2xl font-extrabold text-ink">{t.support.contactTitle}</h2>
  <p class="mt-3 text-sm text-muted">{t.support.contactText}</p>
  <a
    href={`mailto:${t.footer.contactEmail}`}
    class="mt-6 inline-block rounded-btn bg-primary px-6 py-3 text-sm font-bold text-white shadow-card transition hover:bg-primary-dark"
  >
    {t.support.contactButton}
  </a>
</section>
