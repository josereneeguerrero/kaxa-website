---
import { translations } from '../i18n/translations';
import { PLAY_STORE_URL } from '../i18n/constants';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section id="precios" class="bg-grain relative mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <h2 class="text-center text-3xl font-extrabold"><span class="bg-gradient-to-r from-ink to-primary bg-clip-text text-transparent">{t.pricing.title}</span></h2>
  <p class="mx-auto mt-3 max-w-xl text-center text-muted">{t.pricing.subtitle}</p>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {t.pricing.plans.map((plan) => (
      <div
        class={`flex flex-col rounded-card p-6 shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${
          plan.featured ? 'border-2 border-primary bg-primary-light/40' : 'glass-card'
        }`}
      >
        {plan.highlight && (
          <span class="mb-2 inline-block w-fit rounded-full bg-primary px-3 py-1 text-xs font-bold text-white">
            {plan.highlight}
          </span>
        )}
        <h3 class="text-lg font-bold text-ink">{plan.name}</h3>
        <p class="mt-2 text-3xl font-extrabold text-ink">
          {plan.price}<span class="text-sm font-semibold text-muted"> {plan.period}</span>
        </p>
        <ul class="mt-4 flex-1 space-y-2 text-sm text-muted">
          {t.pricing.featuresList.map((feature) => (
            <li class="flex items-start gap-2">
              <span class="text-primary">✓</span>
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <a
          href="#"
          onclick="window.scrollTo({top:0,behavior:'smooth'});return false"
          class="mt-6 rounded-btn bg-primary px-4 py-3 text-center text-sm font-bold text-white hover:bg-primary-dark"
        >
          {plan.cta}
        </a>
      </div>
    ))}
  </div>
  <p class="mt-8 text-center text-xs text-muted">{t.pricing.note}</p>
</section>
