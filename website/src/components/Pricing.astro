---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';
import { PLAY_STORE_URL } from '../i18n/constants';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const plans = t.pricing.plans;
const includes = t.pricing.includesList;
---
<section id="precios" class="bg-grain relative mx-auto max-w-6xl px-4 py-16 sm:px-6">
  <h2 class="text-center text-3xl font-extrabold text-ink">{t.pricing.title}</h2>
  <p class="mx-auto mt-3 max-w-xl text-center text-muted">{t.pricing.subtitle}</p>
  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {plans.map((plan) => (
      <div
        class={`flex min-h-[280px] flex-col items-center justify-center rounded-card p-8 text-center shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lg ${
          plan.featured ? 'border-2 border-primary bg-primary-light/40' : 'glass-card'
        }`}
      >
        {plan.highlight ? (
          <span class="mb-4 inline-block rounded-full bg-primary px-3 py-1 text-xs font-bold text-white">
            {plan.highlight}
          </span>
        ) : (
          <div class="mb-4 h-6"></div>
        )}
        <h3 class="text-xl font-bold text-ink">{plan.name}</h3>
        <p class="mt-3 text-5xl font-extrabold text-ink">
          {plan.price}<span class="text-base font-semibold text-muted"> {plan.period}</span>
        </p>
        {plan.anchor && (
          <p class="mt-3 text-sm text-muted">{plan.anchor}</p>
        )}
        {plan.detail && (
          <p class="mt-1 text-sm font-semibold text-primary">{plan.detail}</p>
        )}
        <a
          href={PLAY_STORE_URL}
          target="_blank"
          rel="noopener"
          class={`mt-6 inline-block w-full rounded-btn px-5 py-2.5 text-sm font-bold transition hover:opacity-90 ${
            plan.featured
              ? 'bg-primary text-white shadow-card'
              : 'border border-primary bg-white text-primary'
          }`}
        >
          {lang === 'es' ? 'Empezar' : 'Get started'}
        </a>
      </div>
    ))}
  </div>

  {includes.length > 0 && (
    <div class="mx-auto mt-12 max-w-2xl rounded-card border border-surface-border bg-white p-6 shadow-card">
      <p class="mb-4 text-center text-sm font-bold uppercase tracking-wide text-primary">
        {lang === 'es' ? 'Todos los planes incluyen' : 'Every plan includes'}
      </p>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3">
        {includes.map((item: string) => (
          <div class="flex items-start gap-2 text-sm text-ink/80">
            <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">✓</span>
            <span>{item}</span>
          </div>
        ))}
      </div>
    </div>
  )}

  <div class="mx-auto mt-8 max-w-md text-center">
    <a
      href={PLAY_STORE_URL}
      target="_blank"
      rel="noopener"
      class="inline-block w-full rounded-btn bg-primary px-8 py-4 text-base font-bold text-white shadow-card hover:bg-primary-dark"
    >
      {t.hero.cta}
    </a>
  </div>

  <p class="mt-4 text-center text-xs text-muted/60">{t.pricing.note}</p>
</section>
