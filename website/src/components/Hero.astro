---
import PhoneMockup from './PhoneMockup.astro';
import { PLAY_STORE_URL } from '../i18n/constants';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const rainIcons: { icon: string; left: number; size: string; duration: number; delay: number; opacity: string }[] = [
  { icon: 'income', left: 2, size: 'h-7 w-7', duration: 18, delay: -2, opacity: 'opacity-50' },
  { icon: 'store', left: 16, size: 'h-6 w-6', duration: 22, delay: -10, opacity: 'opacity-35' },
  { icon: 'transport', left: 30, size: 'h-8 w-8', duration: 16, delay: -6, opacity: 'opacity-45' },
  { icon: 'home', left: 6, size: 'h-7 w-7', duration: 24, delay: -14, opacity: 'opacity-35' },
  { icon: 'health', left: 70, size: 'h-6 w-6', duration: 20, delay: -4, opacity: 'opacity-50' },
  { icon: 'entertainment', left: 88, size: 'h-7 w-7', duration: 17, delay: -9, opacity: 'opacity-40' },
  { icon: 'education', left: 96, size: 'h-8 w-8', duration: 23, delay: -1, opacity: 'opacity-35' },
  { icon: 'personal', left: 22, size: 'h-6 w-6', duration: 25, delay: -18, opacity: 'opacity-45' },
  { icon: 'remesas', left: 80, size: 'h-7 w-7', duration: 19, delay: -7, opacity: 'opacity-50' },
  { icon: 'services', left: 60, size: 'h-6 w-6', duration: 21, delay: -12, opacity: 'opacity-35' },
  { icon: 'food', left: 92, size: 'h-6 w-6', duration: 15, delay: -3, opacity: 'opacity-45' },
  { icon: 'inventory', left: 48, size: 'h-7 w-7', duration: 26, delay: -16, opacity: 'opacity-30' },
];
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-primary-light/30">
  <div
    class="animate-blob pointer-events-none absolute -left-32 -top-32 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="animate-blob pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-primary/10 blur-3xl"
    style="animation-delay: 6s"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div class="reveal">
      <p class="text-xs font-extrabold uppercase tracking-widest text-primary">{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-black leading-tight text-ink sm:text-5xl">{t.hero.title}</h1>
      <p class="mt-4 max-w-md text-base text-muted">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={PLAY_STORE_URL} class="inline-block transition hover:opacity-90">
          <img
            src={`/badges/google-play-badge-${lang}.png`}
            alt={t.hero.cta}
            class="h-14 w-auto"
            width="194"
            height="75"
          />
        </a>
      </div>
    </div>
    <div class="reveal relative" style="transition-delay: 150ms">
      <div class="-inset-x-10 -inset-y-12 absolute overflow-hidden" aria-hidden="true">
        {rainIcons.map((icon) => (
          <img
            src={`/icons/categories/${icon.icon}.svg`}
            alt=""
            class={`animate-icon-rain rounded-lg ${icon.size} ${icon.opacity}`}
            style={`left: ${icon.left}%; animation-duration: ${icon.duration}s; animation-delay: ${icon.delay}s;`}
          />
        ))}
      </div>
      <div class="animate-float relative">
        <PhoneMockup mockup={t.hero.mockup} />
      </div>
    </div>
  </div>
</section>
