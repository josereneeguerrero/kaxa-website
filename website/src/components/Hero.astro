---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = translations[lang];
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.reneeguerrero.kaxa';
---

<section class="hero-section">
  <div class="hero-inner">

    <!-- Text block — centered -->
    <div class="hero-text reveal">
      <p class="hero-eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero-h1">
        {t.hero.title}<br/>
        <span class="hero-accent">{t.hero.titleHighlight}</span>
      </h1>
      <p class="hero-sub">{t.hero.subtitle}</p>
      <div class="hero-badge">
        <a href={playStoreUrl} target="_blank" rel="noopener" class="hero-badge-link">
          <img
            src={lang === 'es' ? '/badges/google-play-badge-es.png' : '/badges/google-play-badge-en.png'}
            alt={lang === 'es' ? 'Disponible en Google Play' : 'Get it on Google Play'}
            class="hero-badge-img"
          />
        </a>
      </div>
      <p class="hero-proof">{lang === 'es' ? 'Gratis · Sin anuncios · Sin cuenta' : 'Free · No ads · No account'}</p>
    </div>

    <!-- App screenshot — clean, no phone chrome -->
    <div class="hero-mockup reveal" style="transition-delay:180ms">
      <div class="hero-phone">
        <video
          autoplay muted loop playsinline
          class="hero-video"
          poster="/screenshots/home.png"
        >
          <source src="/kaxa-demo.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    background: #fff;
    padding: 72px 24px 0;
    text-align: center;
    overflow: hidden;
  }
  .hero-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 56px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }
  .hero-eyebrow {
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    color: #1DB48B;
    margin-bottom: 20px;
  }
  .hero-h1 {
    font-size: clamp(2.4rem, 6vw, 3.75rem);
    font-weight: 900;
    line-height: 1.1;
    color: #0d1512;
    letter-spacing: -.02em;
    text-wrap: balance;
    margin-bottom: 20px;
  }
  .hero-accent {
    color: #1DB48B;
  }
  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: #6b7280;
    line-height: 1.65;
    max-width: 480px;
    margin-bottom: 32px;
  }
  .hero-badge { margin-bottom: 16px; }
  .hero-badge-link {
    display: inline-block;
    transition: opacity .2s, transform .15s;
  }
  .hero-badge-link:hover { opacity: .88; transform: translateY(-1px); }
  .hero-badge-img { height: 52px; }
  .hero-proof {
    font-size: 12px;
    color: #9ca3af;
    letter-spacing: .04em;
  }

  /* Phone mockup */
  .hero-mockup { width: 100%; display: flex; justify-content: center; }
  .hero-phone {
    width: min(300px, 72vw);
    border-radius: 36px 36px 0 0;
    overflow: hidden;
    box-shadow:
      0 -2px 0 rgba(0,0,0,.06),
      -2px 0 0 rgba(0,0,0,.04),
      2px 0 0 rgba(0,0,0,.04),
      0 32px 80px rgba(0,0,0,.14);
  }
  .hero-video {
    display: block;
    width: 100%;
  }

  @media (max-width: 480px) {
    .hero-section { padding: 56px 16px 0; }
    .hero-h1 { font-size: 2.1rem; }
  }
</style>
