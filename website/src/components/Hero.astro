---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props { lang: Lang; }

const { lang } = Astro.props;
const t = translations[lang];
const playStoreUrl = 'https://play.google.com/store/apps/details?id=com.reneeguerrero.kaxa';
---

<section class="hero-section">
  <div class="hero-inner">

    <!-- LEFT: text -->
    <div class="hero-text reveal">
      <h1 class="hero-h1">
        {t.hero.title} <span class="hero-accent">{t.hero.titleHighlight}</span>
      </h1>
      <p class="hero-sub">{t.hero.subtitle}</p>
      <a href={playStoreUrl} target="_blank" rel="noopener" class="hero-badge-link">
        <img
          src={lang === 'es' ? '/badges/google-play-badge-es.png' : '/badges/google-play-badge-en.png'}
          alt={lang === 'es' ? 'Disponible en Google Play' : 'Get it on Google Play'}
          class="hero-badge-img"
        />
      </a>
    </div>

    <!-- RIGHT: phone mockup -->
    <div class="hero-mockup-wrap">
      <img
        src={lang === 'es' ? '/images/hero-mockup-es.png' : '/images/hero-mockup-en.png'}
        alt={lang === 'es' ? 'Pantalla principal de Kaxa' : 'Kaxa home screen'}
        class="hero-mockup-img"
        loading="eager"
        decoding="async"
      />
    </div>

  </div>
</section>

<style>
  .hero-section {
    background: #fff;
    overflow: hidden;
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    padding: 80px 0;
  }
  .hero-inner {
    width: 100%;
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 48px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
  }
  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hero-h1 {
    font-size: clamp(2.8rem, 5.5vw, 4.5rem);
    font-weight: 900;
    line-height: 1.05;
    color: #0d1512;
    letter-spacing: -.025em;
    margin-bottom: 28px;
  }
  .hero-accent { color: #1DB48B; }
  .hero-sub {
    font-size: 1.1rem;
    color: #6b7280;
    line-height: 1.7;
    max-width: 400px;
    margin-bottom: 36px;
  }
  .hero-badge-link {
    display: inline-block;
    transition: opacity .2s, transform .15s;
  }
  .hero-badge-link:hover { opacity: .88; transform: translateY(-1px); }
  .hero-badge-img { height: 52px; display: block; }

  .hero-mockup-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-mockup-img {
    width: 100%;
    max-width: 420px;
    height: auto;
    display: block;
    filter: drop-shadow(0 32px 64px rgba(0,0,0,.13));
  }

  @media (max-width: 768px) {
    .hero-section { padding: 48px 0 56px; }
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: auto;
      padding: 0 24px;
      gap: 0;
    }
    .hero-mockup-wrap { display: none; }
    .hero-text { align-items: center; text-align: center; }
    .hero-sub { max-width: 100%; }
    .hero-h1 { font-size: clamp(2rem, 8vw, 3rem); }
  }
</style>
