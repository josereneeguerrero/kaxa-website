---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section id="faq" class="bg-surface py-16">
  <div class="mx-auto max-w-3xl px-4 sm:px-6">
    <h2 class="text-center text-3xl font-extrabold text-ink">{t.faq.title}</h2>
    <div class="mt-10 space-y-4">
      {t.faq.items.map((item) => (
        <details class="group rounded-card border border-surface-border bg-white p-5 shadow-card">
          <summary class="cursor-pointer list-none text-base font-bold text-ink marker:content-none">
            {item.question}
          </summary>
          <p class="mt-2 text-sm text-muted">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
