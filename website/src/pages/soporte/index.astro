---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQ from '../../components/FAQ.astro';
import SupportContact from '../../components/SupportContact.astro';
import { translations } from '../../i18n/translations';

const lang = 'es' as const;
const t = translations[lang];
---
<BaseLayout lang={lang} currentRoute="support" title={`${t.support.title} — Kaxa`} description={t.meta.description}>
  <section class="mx-auto max-w-3xl px-4 pt-16 text-center sm:px-6">
    <h1 class="text-4xl font-extrabold text-ink">{t.support.title}</h1>
    <p class="mt-3 text-sm leading-relaxed text-muted">{t.support.subtitle}</p>
  </section>
  <FAQ lang={lang} />
  <SupportContact lang={lang} />
</BaseLayout>
