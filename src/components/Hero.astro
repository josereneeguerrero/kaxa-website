---
import PhoneMockup from './PhoneMockup.astro';
import Icon, { type IconName } from './Icon.astro';
import { PLAY_STORE_URL } from '../i18n/constants';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];

const rainIcons: { name: IconName; left: number; size: string; duration: number; delay: number; opacity: string }[] = [
  { name: 'currency-dollar', left: 2, size: 'h-6 w-6', duration: 18, delay: -2, opacity: 'text-primary/25' },
  { name: 'shopping-bag', left: 16, size: 'h-5 w-5', duration: 22, delay: -10, opacity: 'text-primary/15' },
  { name: 'truck', left: 30, size: 'h-7 w-7', duration: 16, delay: -6, opacity: 'text-primary/20' },
  { name: 'home', left: 6, size: 'h-6 w-6', duration: 24, delay: -14, opacity: 'text-primary/15' },
  { name: 'heart', left: 70, size: 'h-5 w-5', duration: 20, delay: -4, opacity: 'text-primary/25' },
  { name: 'film', left: 88, size: 'h-6 w-6', duration: 17, delay: -9, opacity: 'text-primary/20' },
  { name: 'academic-cap', left: 96, size: 'h-7 w-7', duration: 23, delay: -1, opacity: 'text-primary/15' },
  { name: 'wallet', left: 22, size: 'h-5 w-5', duration: 25, delay: -18, opacity: 'text-primary/20' },
  { name: 'banknotes', left: 80, size: 'h-6 w-6', duration: 19, delay: -7, opacity: 'text-primary/25' },
  { name: 'flag', left: 60, size: 'h-5 w-5', duration: 21, delay: -12, opacity: 'text-primary/15' },
  { name: 'currency-dollar', left: 92, size: 'h-5 w-5', duration: 15, delay: -3, opacity: 'text-primary/20' },
  { name: 'shopping-bag', left: 48, size: 'h-6 w-6', duration: 26, delay: -16, opacity: 'text-primary/10' },
];
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-primary-light/30">
  <div
    class="animate-blob pointer-events-none absolute -left-32 -top-32 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="animate-blob pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-primary/10 blur-3xl"
    style="animation-delay: 6s"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div class="reveal">
      <p class="text-xs font-extrabold uppercase tracking-widest text-primary">{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-black leading-tight text-ink sm:text-5xl">{t.hero.title}</h1>
      <p class="mt-4 max-w-md text-base text-muted">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={PLAY_STORE_URL}
          class="group inline-flex items-center gap-2 rounded-btn bg-ink px-6 py-3 text-sm font-bold text-white transition hover:bg-primary hover:shadow-lg hover:shadow-primary/30"
        >
          {t.hero.cta}
          <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
        </a>
        <span class="text-xs font-bold text-muted">{t.hero.badge}</span>
      </div>
    </div>
    <div class="reveal relative" style="transition-delay: 150ms">
      <div class="-inset-x-10 -inset-y-12 absolute overflow-hidden" aria-hidden="true">
        {rainIcons.map((icon) => (
          <Icon
            name={icon.name}
            class={`animate-icon-rain ${icon.size} ${icon.opacity}`}
            style={`left: ${icon.left}%; animation-duration: ${icon.duration}s; animation-delay: ${icon.delay}s;`}
          />
        ))}
      </div>
      <div class="animate-float relative">
        <PhoneMockup mockup={t.hero.mockup} />
      </div>
    </div>
  </div>
</section>
