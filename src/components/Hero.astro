---
import PhoneMockup from './PhoneMockup.astro';
import Icon from './Icon.astro';
import { PLAY_STORE_URL } from '../i18n/constants';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section class="relative overflow-hidden bg-gradient-to-b from-white to-primary-light/30">
  <div
    class="animate-blob pointer-events-none absolute -left-32 -top-32 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="animate-blob pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-primary/10 blur-3xl"
    style="animation-delay: 6s"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div class="reveal">
      <p class="text-xs font-extrabold uppercase tracking-widest text-primary">{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-black leading-tight text-ink sm:text-5xl">{t.hero.title}</h1>
      <p class="mt-4 max-w-md text-base text-muted">{t.hero.subtitle}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a
          href={PLAY_STORE_URL}
          class="group inline-flex items-center gap-2 rounded-btn bg-ink px-6 py-3 text-sm font-bold text-white transition hover:bg-primary hover:shadow-lg hover:shadow-primary/30"
        >
          {t.hero.cta}
          <Icon name="arrow-right" class="h-4 w-4 transition group-hover:translate-x-1" />
        </a>
        <span class="text-xs font-bold text-muted">{t.hero.badge}</span>
      </div>
    </div>
    <div class="reveal relative" style="transition-delay: 150ms">
      <div class="animate-float">
        <PhoneMockup mockup={t.hero.mockup} />
      </div>
      <div
        class="animate-float absolute -left-4 top-8 hidden items-center gap-2 rounded-card bg-white px-3 py-2 shadow-card sm:flex"
        style="animation-delay: 1s"
      >
        <Icon name="wallet" class="h-4 w-4 text-primary" />
        <span class="text-xs font-bold text-ink">{t.features.items[0].title}</span>
      </div>
      <div
        class="animate-float absolute -right-4 bottom-16 hidden items-center gap-2 rounded-card bg-white px-3 py-2 shadow-card sm:flex"
        style="animation-delay: 2s"
      >
        <Icon name="flag" class="h-4 w-4 text-primary" />
        <span class="text-xs font-bold text-ink">{t.features.items[3].title}</span>
      </div>
    </div>
  </div>
</section>
