---
import PhoneMockup from './PhoneMockup.astro';
import { PLAY_STORE_URL } from '../i18n/constants';
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const h = t.hero as any;
const isWaitlist = !!h.ctaWaitlist;
const titleHighlight = h.titleHighlight || '';
const badge = h.badge || '';
const launchDate = h.launchDate || '';
const socialProof = h.socialProof || '';
---
<section class="bg-grain relative overflow-hidden bg-gradient-to-b from-white to-primary-light/30">
  <div
    class="animate-blob pointer-events-none absolute -left-32 -top-32 h-72 w-72 rounded-full bg-primary/20 blur-3xl"
    aria-hidden="true"
  >
  </div>
  <div
    class="animate-blob pointer-events-none absolute -right-24 top-1/3 h-80 w-80 rounded-full bg-primary/10 blur-3xl"
    style="animation-delay: 6s"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-4 py-16 sm:px-6 md:grid-cols-2 md:py-24">
    <div class="reveal">
      <p class="text-xs font-extrabold uppercase tracking-widest text-primary">{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-4xl font-black leading-tight text-ink sm:text-5xl">
        {t.hero.title}{' '}
        {titleHighlight && <span class="bg-gradient-to-r from-primary to-emerald-400 bg-clip-text text-transparent">{titleHighlight}</span>}
      </h1>
      <p class="mt-4 max-w-md text-base text-muted">{t.hero.subtitle}</p>
      {launchDate && (
        <p class="mt-3 text-xs font-semibold text-muted">{launchDate}</p>
      )}
      {isWaitlist ? (
        <div class="mt-8 w-full max-w-md">
          <form id="waitlist-form" class="flex w-full flex-col gap-2 sm:flex-row">
            <input
              type="email"
              name="email"
              required
              placeholder="tucorreo@ejemplo.com"
              class="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm text-ink shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/20"
            />
            <button
              type="submit"
              class="w-full rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-primary/90 active:scale-95 sm:w-auto sm:whitespace-nowrap"
            >
              {t.hero.cta}
            </button>
          </form>
          <div id="waitlist-success" class="mt-2 hidden opacity-0 translate-y-2 transition-all duration-500 ease-out">
            <p class="text-sm font-medium text-primary">
              🎉 ¡Estás en la lista!
            </p>
            <p class="mt-2 text-xs text-muted">Compartí con un amigo — ambos obtienen acceso anticipado.</p>
            <div class="mt-3 flex items-center gap-3">
              <button
                id="share-btn"
                class="inline-flex items-center gap-1.5 rounded-lg bg-primary/10 px-3 py-1.5 text-xs font-bold text-primary transition hover:bg-primary/20"
              >
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                Compartir
              </button>
              <a href="https://www.instagram.com/kaxa.app" target="_blank" rel="noopener" class="text-muted transition hover:text-primary" aria-label="Instagram">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
              </a>
              <a href="https://www.tiktok.com/@kaxa.app" target="_blank" rel="noopener" class="text-muted transition hover:text-primary" aria-label="TikTok">
                <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              </a>
            </div>
          </div>
          {socialProof && (
            <p class="mt-3 flex items-center gap-1.5 text-xs text-muted">
              <span class="inline-block h-2 w-2 rounded-full bg-primary animate-pulse"></span>
              <span class="font-bold text-ink" id="waitlist-count">0</span>
              {socialProof}
            </p>
          )}
        </div>
      ) : (
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <a href={PLAY_STORE_URL} class="inline-block transition hover:opacity-90">
            <img
              src={`/badges/google-play-badge-${lang}.png`}
              alt={t.hero.cta}
              class="h-14 w-auto"
              width="194"
              height="75"
            />
          </a>
        </div>
      )}
    </div>
    <div class="reveal relative" style="transition-delay: 150ms">
      <div class="animate-float relative">
        {isWaitlist ? (
          <div class="mx-auto w-[280px] overflow-hidden rounded-[2.5rem] shadow-2xl">
            <video
              autoplay
              muted
              loop
              playsinline
              class="w-full"
              poster={t.hero.mockup?.src || '/screenshots/home.png'}
            >
              <source src="/kaxa-demo.mp4" type="video/mp4" />
            </video>
          </div>
        ) : (
          <PhoneMockup mockup={t.hero.mockup} />
        )}
      </div>
    </div>
  </div>
</section>

<script>
  const SEED_COUNT = 47;
  const counter = document.getElementById('waitlist-count');
  if (counter) {
    const stored = parseInt(localStorage.getItem('wl_extra') || '0', 10);
    counter.textContent = String(SEED_COUNT + stored);
  }

  const form = document.getElementById('waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('waitlist-success');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email') as string;
      const btn = form.querySelector('button')!;
      btn.textContent = '...';
      btn.disabled = true;
      try {
        await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        form.style.transition = 'opacity 300ms ease-out, transform 300ms ease-out';
        form.style.opacity = '0';
        form.style.transform = 'translateY(-8px)';
        await new Promise(r => setTimeout(r, 300));
        form.classList.add('hidden');
        success?.classList.remove('hidden');
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            if (success) {
              success.style.opacity = '1';
              success.style.transform = 'translateY(0)';
            }
          });
        });
        const extra = parseInt(localStorage.getItem('wl_extra') || '0', 10) + 1;
        localStorage.setItem('wl_extra', String(extra));
        if (counter) counter.textContent = String(SEED_COUNT + extra);
      } catch {
        btn.textContent = 'Reintentar';
        btn.disabled = false;
      }
    });
  }

  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', async () => {
      const shareData = {
        title: 'Kaxa — Tu caja en el bolsillo',
        text: 'Descubrí Kaxa, la app de finanzas personales hecha en Honduras. Registrate para acceso anticipado:',
        url: 'https://kaxa.lat',
      };
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText('https://kaxa.lat');
        shareBtn.textContent = '✓ Link copiado';
        setTimeout(() => { shareBtn.textContent = 'Compartir'; }, 2000);
      }
    });
  }
</script>
