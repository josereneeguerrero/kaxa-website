---
export type IconName = 'pencil' | 'wallet' | 'chart-bar' | 'chevron-down';

interface Props {
  name: IconName;
  class?: string;
  style?: string;
}

const { name, class: className = 'h-5 w-5', style } = Astro.props;

const paths: Record<IconName, string> = {
