---
import { translations } from '../i18n/translations';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
const items = t.features.items as any[];

const eyebrows = lang === 'es'
  ? ['REGISTRO', 'PRESUPUESTOS', 'METAS', 'DEUDAS', 'RESUMEN']
  : ['TRACKING', 'BUDGETS', 'GOALS', 'DEBTS', 'SUMMARY'];
---
<section id="funciones" class="relative overflow-hidden py-16 sm:py-24">
  <div class="relative mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="reveal text-center text-3xl font-extrabold text-ink sm:text-4xl">{t.features.title}</h2>
    <p class="reveal mx-auto mt-3 max-w-xl text-center text-muted" style="transition-delay: 100ms">
      {t.features.subtitle}
    </p>
    <div class="mt-16 flex flex-col gap-24 sm:gap-32">
      {items.map((item: any, i: number) => {
        const reversed = i % 2 === 1;
        const isAlt = i % 2 === 1;
        return (
          <div
            class={`reveal flex flex-col items-center gap-10 sm:gap-16 md:flex-row ${reversed ? 'md:flex-row-reverse' : ''}`}
            style={`transition-delay: ${i * 80}ms`}
          >
            {/* Text side */}
            <div class="flex-1 text-center md:text-left">
              <span class="text-xs font-extrabold uppercase tracking-widest text-primary">
                {eyebrows[i]}
              </span>
              <h3 class="mt-2 text-2xl font-extrabold leading-tight text-ink sm:text-3xl">{item.title}</h3>
              <p class="mt-3 max-w-md text-base leading-relaxed text-muted">{item.description}</p>
              {item.bullets && (
                <ul class="mt-5 space-y-3">
                  {item.bullets.map((b: string) => (
                    <li class="flex items-start gap-3 text-sm text-ink/80">
                      <span class="mt-0.5 flex h-5 w-5 flex-shrink-0 items-center justify-center rounded-full bg-primary/10 text-xs font-bold text-primary">✓</span>
                      <span>{b}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
            {/* Phone side */}
            <div class="relative w-full max-w-[280px] flex-shrink-0 sm:max-w-[300px]">
              <div
                class="pointer-events-none absolute -inset-8 rounded-full opacity-30 blur-3xl"
                style={`background: ${isAlt ? 'radial-gradient(circle, #10B981 0%, transparent 70%)' : 'radial-gradient(circle, #2563EB 0%, transparent 70%)'}`}
                aria-hidden="true"
              ></div>
              <img
                src={item.screenshot}
                alt={item.title}
                class="animate-float-subtle relative w-full rounded-3xl shadow-2xl"
                loading="lazy"
              />
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  @keyframes float-subtle {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .animate-float-subtle {
    animation: float-subtle 5s ease-in-out infinite;
  }
  .animate-float-subtle:nth-child(2n) {
    animation-delay: 2.5s;
  }
  @media (prefers-reduced-motion: reduce) {
    .animate-float-subtle { animation: none; }
  }
</style>
