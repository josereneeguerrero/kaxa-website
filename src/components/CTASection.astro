---
import { translations } from '../i18n/translations';
import { PLAY_STORE_URL } from '../i18n/constants';
import type { Lang } from '../i18n/routes';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<section class="bg-ink py-16 text-center text-white">
  <div class="mx-auto max-w-2xl px-4 sm:px-6">
    <h2 class="text-3xl font-extrabold">{t.cta.title}</h2>
    <p class="mt-3 text-white/70">{t.cta.subtitle}</p>
    {'ctaWaitlist' in t.cta && t.cta.ctaWaitlist ? (
      <form id="cta-waitlist-form" class="mx-auto mt-8 flex max-w-md flex-col gap-2 sm:flex-row">
        <input
          type="email"
          name="email"
          required
          placeholder="tucorreo@ejemplo.com"
          class="w-full rounded-xl border border-white/20 bg-white/10 px-4 py-3 text-sm text-white placeholder-white/40 shadow-sm transition focus:border-primary focus:outline-none focus:ring-2 focus:ring-primary/30"
        />
        <button
          type="submit"
          class="w-full rounded-xl bg-primary px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-primary/90 active:scale-95 sm:w-auto sm:whitespace-nowrap"
        >
          {t.cta.button}
        </button>
      </form>
      <div id="cta-waitlist-success" class="mt-4 hidden">
        <p class="text-sm font-medium text-primary">🎉 ¡Estás en la lista!</p>
        <p class="mt-1 text-xs text-white/50">Compartí con un amigo — ambos obtienen acceso anticipado.</p>
        <div class="mt-3 flex items-center justify-center gap-3">
          <button
            id="cta-share-btn"
            class="inline-flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-bold text-white transition hover:bg-white/20"
          >
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
            Compartir
          </button>
          <a href="https://www.instagram.com/kaxa.app" target="_blank" rel="noopener" class="text-white/40 transition hover:text-primary" aria-label="Instagram">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@kaxa.app" target="_blank" rel="noopener" class="text-white/40 transition hover:text-primary" aria-label="TikTok">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13a8.28 8.28 0 005.58 2.17V11.7a4.85 4.85 0 01-3.77-1.58V6.69h3.77z"/></svg>
          </a>
        </div>
      </div>
    ) : (
      <a href={PLAY_STORE_URL} class="mt-8 inline-block transition hover:opacity-90">
        <img
          src={`/badges/google-play-badge-${lang}.png`}
          alt={t.cta.button}
          class="h-14 w-auto"
          width="194"
          height="75"
        />
      </a>
    )}
  </div>
</section>

<script>
  const form = document.getElementById('cta-waitlist-form') as HTMLFormElement | null;
  const success = document.getElementById('cta-waitlist-success');
  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = new FormData(form).get('email') as string;
      const btn = form.querySelector('button')!;
      btn.textContent = '...';
      btn.disabled = true;
      try {
        await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email }),
        });
        form.classList.add('hidden');
        success?.classList.remove('hidden');
      } catch {
        btn.textContent = 'Reintentar';
        btn.disabled = false;
      }
    });
  }

  const ctaShare = document.getElementById('cta-share-btn');
  if (ctaShare) {
    ctaShare.addEventListener('click', async () => {
      const shareData = {
        title: 'Kaxa — Tu caja en el bolsillo',
        text: 'Descubrí Kaxa, la app de finanzas personales hecha en Honduras. Registrate para acceso anticipado:',
        url: 'https://kaxa.lat',
      };
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText('https://kaxa.lat');
        ctaShare.textContent = '✓ Link copiado';
        setTimeout(() => { ctaShare.textContent = 'Compartir'; }, 2000);
      }
    });
  }
</script>
