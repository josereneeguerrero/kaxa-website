---
import { translations } from '../i18n/translations';
import { routes, type Lang, type RouteKey } from '../i18n/routes';
import { PLAY_STORE_URL } from '../i18n/constants';

interface Props {
  lang: Lang;
  currentRoute: RouteKey;
}

const { lang } = Astro.props;
const t = translations[lang];
---
<footer class="border-t border-surface-border bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-4">
      <div>
        <img src="/images/kaxa_wordmark_green.png" alt="Kaxa" class="h-7 w-auto" />
        <p class="mt-3 text-sm text-muted">{t.footer.tagline}</p>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.legalTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={routes.privacy[lang]} class="hover:text-primary">{t.footer.privacy}</a></li>
          <li><a href={routes.terms[lang]} class="hover:text-primary">{t.footer.terms}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.supportTitle}</h3>
        <ul class="mt-3 space-y-2 text-sm text-muted">
          <li><a href={routes.support[lang]} class="hover:text-primary">{t.footer.supportLink}</a></li>
          <li><a href={`mailto:${t.footer.contactEmail}`} class="hover:text-primary">{t.footer.contactEmail}</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wide text-ink">{t.footer.downloadTitle}</h3>
        <p class="mt-3 text-sm text-muted">Google Play — pronto</p>
        <div class="mt-4 flex items-center gap-3">
          <a href="https://www.instagram.com/kaxa.app" target="_blank" rel="noopener" class="text-muted transition hover:text-primary" aria-label="Instagram">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="https://www.tiktok.com/@kaxa.app" target="_blank" rel="noopener" class="text-muted transition hover:text-primary" aria-label="TikTok">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1v-3.5a6.37 6.37 0 00-.79-.05A6.34 6.34 0 003.15 15.2a6.34 6.34 0 0010.86 4.48V13a8.28 8.28 0 005.58 2.17V11.7a4.85 4.85 0 01-3.77-1.58V6.69h3.77z"/></svg>
          </a>
        </div>
      </div>
    </div>
    <p class="mt-10 text-xs text-muted">{t.footer.copyright}</p>
  </div>
</footer>
