---
interface Props {
  mockup: {
    alt: string;
  };
}

const { mockup } = Astro.props;
---
<div class="relative mx-auto aspect-[6/13] w-[240px] overflow-hidden rounded-[40px] border-[10px] border-ink bg-ink shadow-2xl">
  <span class="absolute left-1/2 top-2.5 z-10 h-2 w-2 -translate-x-1/2 rounded-full bg-ink/70"></span>
  <img
    src="/images/app-screenshot-home.png"
    alt={mockup.alt}
    width="480"
    height="1040"
    class="h-full w-full object-cover"
  />
</div>
