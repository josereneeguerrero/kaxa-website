---
import BaseLayout from './BaseLayout.astro';
import type { Lang, RouteKey } from '../i18n/routes';

interface Props {
  lang: Lang;
  currentRoute: RouteKey;
  title: string;
  description: string;
  heading: string;
  updated: string;
}

const { lang, currentRoute, title, description, heading, updated } = Astro.props;
---
<BaseLayout lang={lang} currentRoute={currentRoute} title={title} description={description}>
  <article class="legal-content mx-auto max-w-3xl px-4 py-16 sm:px-6">
    <h1>{heading}</h1>
    <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-muted">{updated}</p>
    <slot />
  </article>
</BaseLayout>
